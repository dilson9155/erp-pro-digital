// ============================================================================
// MODELOS DE PLATAFORMA — sem tenantId (compartilhados por todas as empresas)
// ============================================================================

/// Catálogo global de permissões. O código referencia `key` (ex.: "sales.create");
/// nunca o id. Renomear um id não quebra nada.
model Permission {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(80)
  /// Módulo dono da permissão (usado para agrupar na UI e no menu).
  module       String   @db.VarChar(40)
  label        String   @db.VarChar(120)
  description  String?
  /// Agrupamento para a tela de configuração de perfis (ex.: "Vendas", "Fiscal").
  group        String   @db.VarChar(60)
  /// Ações cobertas: ["create","read","update","delete","approve","cancel","export"].
  actions      String[]
  /// Somente o super admin da plataforma pode conceder esta permissão.
  platformOnly Boolean  @default(false) @map("platform_only")

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([module])
  @@index([group])
  @@map("permissions")
}

/// Perfil. `tenantId = NULL` marca um perfil de SISTEMA (matriz de permissões
/// padrão). Ao provisionar uma empresa, o perfil de sistema é clonado para a
/// empresa, permitindo ajuste sem afetar as demais.
model Role {
  id          String    @id @default(cuid())
  tenantId    String?   @map("tenant_id")
  name        String    @db.VarChar(80)
  slug        String    @db.VarChar(60)
  description String?
  scope       RoleScope @default(TENANT)
  /// Perfil de sistema: não pode ser apagado nem renomeado.
  isSystem    Boolean   @default(false) @map("is_system")
  active      Boolean   @default(true)

  permissions RolePermission[]
  memberships MembershipRole[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Plano SaaS. PREÇOS E LIMITES VIVEM AQUI — nunca no código do front.
/// A UI lê este model; o servidor valida os limites antes de cada escrita.
model Plan {
  id               String        @id @default(cuid())
  code             String        @unique @db.VarChar(40)
  name             String        @db.VarChar(80)
  description      String
  /// Preço em centavos. 0 = gratuito / sob consulta.
  priceCents       Int           @default(0) @map("price_cents")
  /// Preço do ciclo anual cheio. 0 = `priceCents * 12`.
  annualPriceCents Int           @default(0) @map("annual_price_cents")
  currency         String        @default("BRL") @db.Char(3)
  billingPeriod    BillingPeriod @default(MENSAL)
  /// Duração do trial. Configurável pelo super admin — NUNCA fixo no código.
  trialDays        Int           @default(0) @map("trial_days")

  // Limites. 0 = ilimitado.
  maxUsers            Int @default(0) @map("max_users")
  maxProducts         Int @default(0) @map("max_products")
  maxCustomers        Int @default(0) @map("max_customers")
  maxSuppliers        Int @default(0) @map("max_suppliers")
  maxBranches         Int @default(0) @map("max_branches")
  maxInvoicesPerMonth Int @default(0) @map("max_invoices_per_month")
  maxSalesPerMonth    Int @default(0) @map("max_sales_per_month")
  maxStorageMb        Int @default(0) @map("max_storage_mb")

  features  String[]
  sortOrder Int      @default(0) @map("sort_order")
  highlight Boolean  @default(false)
  active    Boolean  @default(true)

  modules       PlanModule[]
  tenants       Tenant[]
  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("plans")
}

model PlanModule {
  planId String        @map("plan_id")
  module PlanModuleKey

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, module])
  @@map("plan_modules")
}

/// Conta SaaS de uma empresa. É o `tenantId` presente em todos os models de
/// negócio. NÃO é a empresa legal: essa é `Company`.
model Tenant {
  id               String           @id @default(cuid())
  /// Slug global único, base para subdomínio: {slug}.{dominio}
  slug             String           @unique @db.VarChar(60)
  name             String           @db.VarChar(120)
  status           TenantStatus     @default(PENDENTE)
  /// Passo do onboarding atual (0 = não iniciado). Ver `src/modules/onboarding`.
  onboardingStep   Int              @default(0) @map("onboarding_step")
  welcomeTourState WelcomeTourState @default(NAO_INICIADO) @map("welcome_tour_state")

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Espelho do status da assinatura, para consulta rápida no proxy/layout.
  subscriptionStatus  SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  /// Bloqueio por assinatura. O dado é preservado; apenas o acesso é limitado.
  blockedAt           DateTime?          @map("blocked_at")
  blockedReason       String?            @map("blocked_reason")
  /// Acesso somente-leitura quando bloqueado.
  readOnlyWhenBlocked Boolean            @default(true) @map("read_only_when_blocked")

  logoUrl      String? @map("logo_url")
  primaryColor String? @map("primary_color")
  timezone     String  @default("America/Sao_Paulo") @db.VarChar(60)
  locale       String  @default("pt-BR") @db.VarChar(10)
  currency     String  @default("BRL") @db.Char(3)
  settings     Json    @default("{}")
  metadata     Json    @default("{}")

  /// Espelho 1:1 da assinatura corrente, para leitura rápida no layout e no
  /// proxy sem JOIN. A verdade continua sendo `Subscription`.
  subscription    Subscription?    @relation("TenantCurrentSubscription")
  companies       Company[]
  branches        Branch[]
  memberships     Membership[]
  sessions        Session[]
  billingInvoices BillingInvoice[]
  usage           TenantUsage[]
  tickets         SupportTicket[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  tenantSettings TenantSetting[]

  // Cadastros
  categories     Category[]
  brands         Brand[]
  units          Unit[]
  products       Product[]
  services       Service[]
  customers      Customer[]
  suppliers      Supplier[]
  returnReasons  ReturnReason[]
  paymentMethods PaymentMethod[]
  paymentTerms   PaymentTerms[]

  // Estoque
  stockItems      StockItem[]
  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  inventories     Inventory[]
  numberSequences NumberSequence[]

  // Vendas
  quotes              Quote[]
  salesOrders         SalesOrder[]
  sales               Sale[]
  paymentTransactions PaymentTransaction[]
  saleReturns         SaleReturn[]

  // Compras
  purchases Purchase[]

  // Financeiro
  chartOfAccounts     ChartOfAccount[]
  costCenters         CostCenter[]
  bankAccounts        BankAccount[]
  bankReconciliations BankReconciliation[]
  cashRegisters       CashRegister[]
  cashMovements       CashMovement[]
  financialEntries    FinancialEntry[]
  settlements         Settlement[]
  accountsReceivable  AccountsReceivable[]
  accountsPayable     AccountsPayable[]
  installments        Installment[]

  // Comissões
  commissionRules CommissionRule[]
  commissions     Commission[]

  // Fiscal
  fiscalIntegrations FiscalIntegration[]
  fiscalConfigs      FiscalConfig[]
  fiscalSeries       FiscalSeries[]
  taxRules           TaxRule[]
  certificates       Certificate[]
  invoices           Invoice[]
  fiscalLogs         FiscalLog[]
  fiscalJobs         FiscalJob[]

  // --- Filhas com tenant proprio (ver ADR 0002) ---
  subscriptionEvents      SubscriptionEvent[]
  stockTransferItems      StockTransferItem[]
  inventoryItems          InventoryItem[]
  quoteItems              QuoteItem[]
  salesOrderItems         SalesOrderItem[]
  saleItems               SaleItem[]
  saleReturnItems         SaleReturnItem[]
  commissionItems         CommissionItem[]
  bankReconciliationItems BankReconciliationItem[]
  purchaseItems           PurchaseItem[]
  invoiceItems            InvoiceItem[]
  invoiceEvents           InvoiceEvent[]
  consentLogs             ConsentLog[]
  dataSubjectRequests     DataSubjectRequest[]
  supportMessages         SupportMessage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([planId])
  @@index([subscriptionStatus])
  @@index([currentPeriodEnd])
  @@map("tenants")
}

/// Assinatura corrente. Uma por tenant (`tenantId` unique).
/// NUNCA armazenamos dados de cartão. Se houver gateway, guardamos apenas o
/// identificador do cliente e da assinatura no PSP.
model Subscription {
  id       String             @id @default(cuid())
  tenantId String             @unique @map("tenant_id")
  planId   String             @map("plan_id")
  status   SubscriptionStatus @default(TRIAL)

  startedAt          DateTime  @default(now()) @map("started_at")
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  cancelReason       String?   @map("cancel_reason")

  /// Preço congelado na contratação. Alterar o plano não reescreve o histórico.
  priceCents    Int           @default(0) @map("price_cents")
  currency      String        @default("BRL") @db.Char(3)
  billingPeriod BillingPeriod @default(MENSAL)

  externalCustomerId     String? @map("external_customer_id")
  externalSubscriptionId String? @unique @map("external_subscription_id")

  tenant   Tenant              @relation("TenantCurrentSubscription", fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices BillingInvoice[]
  events   SubscriptionEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Trilha imutável de mudanças de assinatura (auditoria de cobrança).
model SubscriptionEvent {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")
  /// Ex.: "created", "upgraded", "payment_failed", "canceled", "renewed".
  event          String @db.VarChar(60)
  payload        Json?
  /// Origem: "platform_admin", "billing_webhook", "system".
  source         String @db.VarChar(40)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([tenantId])
  @@map("subscription_events")
}

model BillingInvoice {
  id              String               @id @default(cuid())
  tenantId        String               @map("tenant_id")
  subscriptionId  String?              @map("subscription_id")
  number          String               @db.VarChar(40)
  amountCents     Int                  @map("amount_cents")
  paidAmountCents Int                  @default(0) @map("paid_amount_cents")
  currency        String               @default("BRL") @db.Char(3)
  status          BillingInvoiceStatus @default(PENDENTE)
  dueDate         DateTime             @map("due_date")
  paidAt          DateTime?            @map("paid_at")
  periodStart     DateTime?            @map("period_start")
  periodEnd       DateTime?            @map("period_end")
  externalId      String?              @unique @map("external_id")
  receiptUrl      String?              @map("receipt_url")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@map("billing_invoices")
}

/// Uso agregado por competência ("YYYY-MM"). Alimenta o painel da plataforma,
/// o alerta de limite de plano e a cobrança por uso futura.
model TenantUsage {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  period         String   @db.Char(7)
  users          Int      @default(0)
  products       Int      @default(0)
  customers      Int      @default(0)
  suppliers      Int      @default(0)
  branches       Int      @default(0)
  sales          Int      @default(0)
  invoicesIssued Int      @default(0) @map("invoices_issued")
  salesAmount    Decimal  @default(0) @map("sales_amount") @db.Decimal(14, 2)
  storageBytes   BigInt   @default(0) @map("storage_bytes")
  computedAt     DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, period])
  @@index([tenantId, computedAt])
  @@map("tenant_usage")
}

/// Catálogo de provedores fiscais suportados. As credenciais ficam em
/// `FiscalIntegration` (por empresa), nunca aqui.
model FiscalProvider {
  id          String   @id @default(cuid())
  /// Chave usada na configuração da empresa: "focus", "tecnospeed", "nfe_io".
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  vendor      String?  @db.VarChar(80)
  description String?
  /// Documentação oficial do provedor. SEMPRE consultar antes de integrar.
  docsUrl     String?  @map("docs_url")
  /// Modelos suportados: ["NF_E","NF_CE","NFS_E"].
  supports    String[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")

  integrations FiscalIntegration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("fiscal_providers")
}

/// Tabela NCM de referência (sem tenantId). Mantida atualizada por job ou por
/// carga manual. `tableVersion` permite conviver com duas vigências.
model Ncm {
  /// Código sem ponto: "22011000".
  code            String  @id @db.VarChar(12)
  description     String
  /// Ex.: "2024-A" (Resolução CONAB). Vigência da tabela.
  tableVersion    String? @map("table_version") @db.VarChar(20)
  /// Origem default sugerida (0..8). Sugestão apenas — o contador confirma.
  suggestedOrigin Int?
  active          Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("ncm")
}

model Municipality {
  /// Código IBGE de 7 dígitos.
  ibgeCode            String      @id @map("ibge_code") @db.VarChar(7)
  name                String      @db.VarChar(120)
  uf                  BrazilState
  /// Provedor nacional de NFS-e do município, quando existir.
  nationalNfeProvider String?     @map("national_nfe_provider") @db.VarChar(60)
  active              Boolean     @default(true)

  companies Company[]
  branches  Branch[]
  services  Service[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([uf, name])
  @@map("municipalities")
}

model PlatformSetting {
  key         String  @id @db.VarChar(80)
  value       Json
  description String?
  /// Lido apenas no servidor; nunca serializado para o cliente.
  sensitive   Boolean @default(false)
  updatedById String? @map("updated_by_id")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ============================================================================
// IDENTIDADE — global. O mesmo login pode acessar várias empresas.
// ============================================================================

model User {
  id                 String     @id @default(cuid())
  /// E-mail normalizado (lowercase, trim). Único na plataforma inteira.
  email              String     @unique @db.VarChar(180)
  /// bcrypt (custo = BCRYPT_COST). NUNCA texto puro, nunca reversível.
  passwordHash       String?    @map("password_hash")
  name               String     @db.VarChar(140)
  phone              String?    @db.VarChar(20)
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(PENDENTE_ATIVACAO)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  /// Senha provisoria: o usuario tem de troca-la antes de usar o sistema.
  ///
  /// Bloqueia TUDO, inclusive a escolha de empresa — a senha redefinida por
  /// terceiro e o principal vetor de tomada de conta, e deixar a pessoa escolher
  /// a empresa antes de trocar a senha ja devolve acesso a algum lugar.
  ///
  /// Liberado so pela propria troca, que grava o novo hash e desliga o flag na
  /// mesma operacao. Nao vale para super admin da plataforma.
  ///
  /// Quem aplica isto: `decidirAcesso`, em `src/server/auth/policy.ts`. Ver ADR 0003.
  mustChangePassword Boolean    @default(false) @map("must_change_password")

  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip")
  /// Contador de falhas consecutivas. Zera no login bem-sucedido.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// Bloqueio temporário após brute force.
  lockedUntil      DateTime? @map("locked_until")

  /// Segredo TOTP cifrado em repouso (AES-256-GCM). Só o app decifra.
  /// O formato é `v1.<sal>.<nonce>.<ciphertext>.<tag>`, com a chave derivada
  /// de `AUTH_SECRET` por HKDF. Texto puro aqui transformaria o segundo fator
  /// em decoração: um dump de `users` bastaria para clonar o segundo fator.
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabledAt       DateTime? @map("totp_enabled_at")

  /// Códigos de recuperação, como array JSON de SHA-256 em base64url.
  ///
  /// Os códigos em texto claro são entregues UMA vez e nunca são gravados.
  /// SHA-256 basta aqui, e bcrypt não: cada código tem ~50 bits de entropia de
  /// `randomBytes`, então não há dicionário para ataque offline, e este caminho
  /// é justamente o de quem já perdeu o acesso e não pode esperar 100 ms por
  /// tentativa. Array e não model separado porque o conjunto é sempre lido e
  /// escrito inteiro, nunca consultado por código.
  totpRecoveryHashes String? @map("totp_recovery_hashes")

  /// Último passo de TOTP aceito, para impedir REPLAY.
  ///
  /// Um código vale por 90 s (o passo de 30 s e os vizinhos, para tolerar
  /// desvio de relógio). Quem vir o código na tela da vítima pode reapresentá-lo
  /// dentro dessa janela. Gravar o último passo usado e recusar qualquer passo
  /// `<=` a ele transforma a janela em uso único. `BigInt` e não `Int`: o passo
  /// é `floor(unix / 30)` e um Int de 32 bits estoura em 2038.
  totpLastStep BigInt? @map("totp_last_step")

  /// Super admin da PLATAFORMA. NÃO concede acesso a dados de empresa por si
  /// só: o acesso ainda exige `Membership`. Acessos de super admin a dados de
  /// tenant são registrados em `AuditLog` com `isImpersonation`.
  ///
  /// Lido em um lugar só — `decidirAcesso`, em `src/server/auth/policy.ts` — e
  /// ali não abre atalho: sem `Membership`, a resposta é NÃO. Ver ADR 0003.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  platformAdminAt DateTime? @map("platform_admin_at")

  memberships                Membership[]
  sessions                   Session[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  passwordResetTokens        PasswordResetToken[]
  consents                   ConsentLog[]
  dataSubjectRequests        DataSubjectRequest[]
  stockMovements             StockMovement[]
  salesAsSeller              Sale[]               @relation("SaleSeller")
  salesAsCreator             Sale[]               @relation("SaleCreator")
  quotesCreated              Quote[]              @relation("QuoteCreator")
  ordersCreated              SalesOrder[]         @relation("OrderCreator")
  salesReturnsApproved       SaleReturn[]         @relation("SaleReturnApprover")
  purchasesCreated           Purchase[]           @relation("PurchaseCreator")
  invoicesIssued             Invoice[]            @relation("InvoiceIssuer")
  commissionRules            CommissionRule[]     @relation("CommissionRuleSeller")
  commissions                CommissionRule[]     @relation("CommissionRuleCreator")
  commissionsAsSeller        Commission[]         @relation("CommissionSeller")
  cashRegistersOpened        CashRegister[]       @relation("CashRegisterOpener")
  cashRegistersClosed        CashRegister[]       @relation("CashRegisterCloser")
  supportTicketsOpened       SupportTicket[]      @relation("TicketOpener")
  supportTicketsAssigned     SupportTicket[]      @relation("TicketAssignee")
  supportMessages            SupportMessage[]     @relation("SupportMessageAuthor")
  cashMovements              CashMovement[]       @relation("CashMovementCreator")
  invoiceEvents              InvoiceEvent[]       @relation("InvoiceEventCreator")
  dataSubjectRequestsHandled DataSubjectRequest[] @relation("DataSubjectHandler")
  purchasesAsSeller          Purchase[]           @relation("PurchaseSeller")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastSeenAt DateTime? @map("last_seen_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([status])
  @@index([isPlatformAdmin])
  @@index([deletedAt])
  @@map("users")
}

/// Sessão revogável. O cookie carrega apenas o `id` (opaco) assinado com
/// AUTH_SECRET; a verdade sobre a sessão está NESTA TABELA. Isso permite:
/// revogação imediata (bloqueio de assinatura, troca de senha, logout global),
/// auditoria de IP/user-agent e expiração real.
model Session {
  id           String  @id @default(cuid())
  /// SHA-256 do token do cookie. O token em claro NUNCA é persistido.
  tokenHash    String  @unique @map("token_hash")
  userId       String  @map("user_id")
  membershipId String? @map("membership_id")
  /// Empresa ativa. NULL = o usuário ainda precisa escolher a empresa.
  tenantId     String? @map("tenant_id")
  /// Filial ativa. NULL = todas as filiais liberadas (conforme `UserBranchAccess`).
  branchId     String? @map("branch_id")

  status        SessionStatus @default(ATIVA)
  expiresAt     DateTime      @map("expires_at")
  lastSeenAt    DateTime      @default(now()) @map("last_seen_at")
  revokedAt     DateTime?     @map("revoked_at")
  revokedReason String?       @map("revoked_reason")
  /// Quantidade de "estou vivo" enviados pelo cliente. Alto volume = replay.
  activityCount Int           @default(0) @map("activity_count")

  ip                      String? @db.VarChar(64)
  userAgent               String? @map("user_agent")
  /// "Lembrar acesso": sessão longa.
  rememberMe              Boolean @default(false) @map("remember_me")
  /// Identificador de sessão do super admin que abriu a sessão de um tenant.
  impersonatedBySessionId String? @map("impersonated_by_session_id")
  impersonationReason     String? @map("impersonation_reason")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([expiresAt])
  @@index([tenantId, status])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// SHA-256 do token. Uso único.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?   @db.VarChar(64)
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// Vínculo usuário ↔ empresa. Um usuário pode ter várias.
model Membership {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  /// Dono da conta. Único por tenant (garantido em código + índice único parcial).
  isOwner         Boolean   @default(false) @map("is_owner")
  active          Boolean   @default(true)
  hiredAt         DateTime? @map("hired_at")
  notes           String?
  /// Saldo de crédito interno do usuário (ex.: vale/crédito do vendedor).
  internalBalance Decimal   @default(0) @map("internal_balance") @db.Decimal(14, 2)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  branchAccess UserBranchAccess[]
  sessions     Session[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// Restringe o usuário a determinadas filiais. Sem nenhum registro, o usuário
/// vê todas as filiais da empresa. Com registros, vê APENAS estas.
model UserBranchAccess {
  membershipId String @map("membership_id")
  branchId     String @map("branch_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

// ============================================================================
// EMPRESA, FILIAIS E CONFIGURAÇÃO POR EMPRESA
// ============================================================================

/// Empresa legal (o CNPJ que emite). Uma conta SaaS pode ter mais de uma
/// empresa legal (emitir em CNPJs distintos), mas começa com uma.
model Company {
  id                    String     @id @default(cuid())
  tenantId              String     @map("tenant_id")
  /// Só a empresa matriz emite NF-e com o CNPJ principal.
  isHeadquarters        Boolean    @default(true) @map("is_headquarters")
  name                  String     @db.VarChar(180)
  tradeName             String?    @map("trade_name") @db.VarChar(180)
  cnpj                  String     @db.VarChar(18)
  cpf                   String?    @db.VarChar(14)
  stateRegistration     String?    @map("state_registration") @db.VarChar(20)
  municipalRegistration String?    @map("municipal_registration") @db.VarChar(20)
  /// CNAE principal e demais, ambos como string de dígitos.
  cnaeMain              String?    @map("cnae_main") @db.VarChar(10)
  cnaeAdditional        String[]   @default([]) @map("cnae_additional")
  legalNature           String?    @map("legal_nature") @db.VarChar(120)
  taxRegime             TaxRegime?
  /// Ano em que a empresa optou pelo Simples Nacional. Usado para lembrar a
  /// emissão do Comunicado Mensal de Resumo de Faturamento quando o anexo exigir.
  simplesOptionYear     Int?       @map("simples_option_year")
  socialCapital         Decimal    @default(0) @map("social_capital") @db.Decimal(14, 2)

  zipCode           String?            @map("zip_code") @db.VarChar(8)
  street            String?            @db.VarChar(150)
  streetNumber      String?            @map("street_number") @db.VarChar(20)
  streetComplement  String?            @map("street_complement") @db.VarChar(80)
  district          String?            @db.VarChar(80)
  city              String?            @db.VarChar(100)
  state             BrazilState?
  countryCode       String             @default("BRASIL") @map("country_code") @db.VarChar(60)
  ibgeCode          String?            @map("ibge_code") @db.VarChar(7)
  addressKind       AddressKind?
  fiscalAddressKind FiscalAddressKind?

  phone          String? @db.VarChar(20)
  email          String? @db.VarChar(180)
  website        String? @db.VarChar(180)
  logoUrl        String? @map("logo_url")
  colorHex       String? @map("color_hex") @db.VarChar(7)
  municipalityId String? @map("municipality_id") @db.VarChar(7)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [ibgeCode], onDelete: SetNull)
  branches     Branch[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, cnpj])
  @@index([tenantId, isHeadquarters])
  @@index([tenantId, taxRegime])
  @@map("companies")
}

/// Filial / matriz. Toda operação (venda, compra, estoque, nota) pertence a
/// exatamente uma filial — é o eixo obrigatório de consolidação de relatórios.
model Branch {
  id                    String  @id @default(cuid())
  tenantId              String  @map("tenant_id")
  companyId             String  @map("company_id")
  name                  String  @db.VarChar(120)
  code                  String  @db.VarChar(20)
  isHeadquarters        Boolean @default(false) @map("is_headquarters")
  cnpj                  String  @db.VarChar(18)
  nameLegal             String? @map("name_legal") @db.VarChar(180)
  tradeName             String? @map("trade_name") @db.VarChar(180)
  stateRegistration     String? @map("state_registration") @db.VarChar(20)
  municipalRegistration String? @map("municipal_registration") @db.VarChar(20)

  zipCode           String?            @map("zip_code") @db.VarChar(8)
  street            String?            @db.VarChar(150)
  streetNumber      String?            @map("street_number") @db.VarChar(20)
  streetComplement  String?            @map("street_complement") @db.VarChar(80)
  district          String?            @db.VarChar(80)
  city              String?            @db.VarChar(100)
  state             BrazilState?
  countryCode       String             @default("BRASIL") @map("country_code") @db.VarChar(60)
  ibgeCode          String?            @map("ibge_code") @db.VarChar(7)
  addressKind       AddressKind?
  fiscalAddressKind FiscalAddressKind?

  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(180)
  managerName    String?  @map("manager_name") @db.VarChar(120)
  latitude       Decimal? @db.Decimal(12, 8)
  longitude      Decimal? @db.Decimal(12, 8)
  active         Boolean  @default(true)
  municipalityId String?  @map("municipality_id") @db.VarChar(7)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  municipality     Municipality?      @relation(fields: [municipalityId], references: [ibgeCode], onDelete: SetNull)
  userBranchAccess UserBranchAccess[]

  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  stockItems         StockItem[]
  stockMovements     StockMovement[]
  stockTransfersFrom StockTransfer[]      @relation("TransferOrigin")
  stockTransfersTo   StockTransfer[]      @relation("TransferDestination")
  sales              Sale[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  saleReturns        SaleReturn[]
  purchases          Purchase[]
  invoices           Invoice[]
  fiscalConfigs      FiscalConfig[]
  fiscalSeries       FiscalSeries[]
  taxRules           TaxRule[]
  certificates       Certificate[]
  numberSequences    NumberSequence[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  bankAccounts       BankAccount[]
  paymentMethods     PaymentMethod[]
  paymentTerms       PaymentTerms[]
  financialEntries   FinancialEntry[]
  accountsReceivable AccountsReceivable[]
  accountsPayable    AccountsPayable[]
  chartOfAccounts    ChartOfAccount[]
  costCenters        CostCenter[]
  commissionRules    CommissionRule[]
  commissions        Commission[]
  services           Service[]
  inventories        Inventory[]
  installments       Installment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@unique([tenantId, cnpj])
  @@index([tenantId, active])
  @@index([companyId])
  @@map("branches")
}

/// Configuração chave/valor por empresa. Valores default vivem no código
/// (`src/modules/settings/defaults.ts`); aqui ficam as customizações.
/// Exemplos: "stock.cost_method", "sale.allow_negative_stock",
/// "pdv.require_customer_for_amount", "fiscal.default_cfop".
model TenantSetting {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  key         String  @db.VarChar(100)
  value       Json
  description String?
  updatedById String? @map("updated_by_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// ============================================================================
// CLIENTES E FORNECEDORES
// ============================================================================

model Customer {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  /// Filial de origem do cadastro. NULL = cadastro global da empresa.
  branchId   String?    @map("branch_id")
  personType PersonType
  name       String     @db.VarChar(180)
  tradeName  String?    @map("trade_name") @db.VarChar(180)

  /// Documento gravado apenas com dígitos. A formatação é responsabilidade da
  /// camada de apresentação. O índice único por tenant impede duplicidade.
  cpf                   String?   @db.VarChar(11)
  cnpj                  String?   @db.VarChar(14)
  /// Valor original do XML quando não bate com CPF/CNPJ (divergência a resolver).
  documentRaw           String?   @map("document_raw") @db.VarChar(20)
  stateRegistration     String?   @map("state_registration") @db.VarChar(20)
  municipalRegistration String?   @map("municipal_registration") @db.VarChar(20)
  birthDate             DateTime? @map("birth_date")

  email              String?   @db.VarChar(180)
  phone              String?   @db.VarChar(20)
  whatsapp           String?   @db.VarChar(20)
  /// Consentimento de marketing/comunicação, com base legal (LGPD art. 7).
  marketingConsentAt DateTime? @map("marketing_consent_at")

  zipCode           String?            @map("zip_code") @db.VarChar(8)
  street            String?            @db.VarChar(150)
  streetNumber      String?            @map("street_number") @db.VarChar(20)
  streetComplement  String?            @map("street_complement") @db.VarChar(80)
  district          String?            @db.VarChar(80)
  city              String?            @db.VarChar(100)
  state             BrazilState?
  countryCode       String             @default("BRASIL") @map("country_code") @db.VarChar(60)
  ibgeCode          String?            @map("ibge_code") @db.VarChar(7)
  addressKind       AddressKind?
  fiscalAddressKind FiscalAddressKind?

  creditLimit           Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  defaultPaymentTermsId String?  @map("default_payment_terms_id")
  notes                 String?
  tags                  String[]
  active                Boolean  @default(true)

  /// Total denormalizado, recalculado por job. Acelera dashboard, curva ABC e
  /// ordenação por valor. Fonte da verdade: `Sale` + `SaleItem`.
  totalPurchased Decimal   @default(0) @map("total_purchased") @db.Decimal(14, 2)
  /// Saldo devedor (contas a receber em aberto).
  totalDebt      Decimal   @default(0) @map("total_debt") @db.Decimal(14, 2)
  purchaseCount  Int       @default(0) @map("purchase_count")
  lastPurchaseAt DateTime? @map("last_purchase_at")

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  defaultPaymentTerms PaymentTerms? @relation(fields: [defaultPaymentTermsId], references: [id], onDelete: SetNull)

  sales               Sale[]
  quotes              Quote[]
  salesOrders         SalesOrder[]
  saleReturns         SaleReturn[]
  invoices            Invoice[]
  accountsReceivable  AccountsReceivable[]
  consentLogs         ConsentLog[]
  dataSubjectRequests DataSubjectRequest[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnpj])
  @@index([tenantId, name])
  @@index([tenantId, active, deletedAt])
  @@index([tenantId, totalDebt])
  @@index([tenantId, lastPurchaseAt])
  @@index([branchId])
  @@map("customers")
}

model Supplier {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  branchId   String?    @map("branch_id")
  personType PersonType @default(JURIDICA)
  name       String     @db.VarChar(180)
  tradeName  String?    @map("trade_name") @db.VarChar(180)

  cpf                   String? @db.VarChar(11)
  cnpj                  String? @db.VarChar(14)
  documentRaw           String? @map("document_raw") @db.VarChar(20)
  stateRegistration     String? @map("state_registration") @db.VarChar(20)
  municipalRegistration String? @map("municipal_registration") @db.VarChar(20)

  email       String? @db.VarChar(180)
  phone       String? @db.VarChar(20)
  whatsapp    String? @db.VarChar(20)
  contactName String? @map("contact_name") @db.VarChar(120)

  zipCode           String?            @map("zip_code") @db.VarChar(8)
  street            String?            @db.VarChar(150)
  streetNumber      String?            @map("street_number") @db.VarChar(20)
  streetComplement  String?            @map("street_complement") @db.VarChar(80)
  district          String?            @db.VarChar(80)
  city              String?            @db.VarChar(100)
  state             BrazilState?
  countryCode       String             @default("BRASIL") @map("country_code") @db.VarChar(60)
  ibgeCode          String?            @map("ibge_code") @db.VarChar(7)
  addressKind       AddressKind?
  fiscalAddressKind FiscalAddressKind?

  bankName      String? @map("bank_name") @db.VarChar(80)
  bankCode      String? @map("bank_code") @db.VarChar(10)
  agency        String? @db.VarChar(20)
  agencyDigit   String? @map("agency_digit") @db.VarChar(4)
  accountNumber String? @map("account_number") @db.VarChar(30)
  accountDigit  String? @map("account_digit") @db.VarChar(4)
  pixKeyType    String? @map("pix_key_type") @db.VarChar(20)
  pixKey        String? @map("pix_key") @db.VarChar(140)

  notes               String?
  tags                String[]
  active              Boolean   @default(true)
  totalPurchased      Decimal   @default(0) @map("total_purchased") @db.Decimal(14, 2)
  totalDebt           Decimal   @default(0) @map("total_debt") @db.Decimal(14, 2)
  purchaseCount       Int       @default(0) @map("purchase_count")
  lastPurchaseAt      DateTime? @map("last_purchase_at")
  averageLeadTimeDays Int       @default(0) @map("average_lead_time_days")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  purchases       Purchase[]
  invoices        Invoice[]
  accountsPayable AccountsPayable[]
  stockMovements  StockMovement[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnpj])
  @@index([tenantId, name])
  @@index([tenantId, active, deletedAt])
  @@index([branchId])
  @@map("suppliers")
}

// ============================================================================
// CATÁLOGO DE PRODUTOS E SERVIÇOS
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  parentId    String? @map("parent_id")
  name        String  @db.VarChar(140)
  code        String? @db.VarChar(40)
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  services        Service[]
  inventories     Inventory[]
  commissionRules CommissionRule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@index([tenantId, active])
  @@map("categories")
}

model Brand {
  id       String  @id @default(cuid())
  tenantId String  @map("tenant_id")
  name     String  @db.VarChar(120)
  code     String? @db.VarChar(40)
  logoUrl  String? @map("logo_url")
  active   Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("brands")
}

/// Unidade de medida. O campo `name` guarda o símbolo (kg, un, cx) e
/// `decimalPlaces` quantas casas o preço unitário aceita.
model Unit {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id")
  name          String  @db.VarChar(8)
  description   String? @db.VarChar(80)
  decimalPlaces Int     @default(2) @map("decimal_places")
  active        Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  services Service[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("units")
}

model Product {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  branchId   String? @map("branch_id")
  categoryId String? @map("category_id")
  brandId    String? @map("brand_id")
  unitId     String  @map("unit_id")

  type        ProductType @default(MERCADORIA)
  /// Código interno (SKU). Único por tenant.
  sku         String      @db.VarChar(60)
  /// Código de barras: EAN-13, EAN-8, UPC-A, ITF-14 ou Code-128. Guardamos
  /// apenas dígitos para não ter variations por tipo de código.
  barcode     String?     @db.VarChar(20)
  name        String      @db.VarChar(200)
  description String?
  /// Texto de busca interna.
  searchTerms String[]    @default([]) @map("search_terms")

  unitPrice           Decimal  @default(0) @map("unit_price") @db.Decimal(14, 4)
  /// Preço de venda com margem aplicada (allows custom price per product).
  retailPrice         Decimal  @default(0) @map("retail_price") @db.Decimal(14, 4)
  wholesalePrice      Decimal  @default(0) @map("wholesale_price") @db.Decimal(14, 4)
  /// Margem de lucro alvo em percentual (ex.: 35.0000 = 35%). Não é alíquota
  /// fiscal: é política comercial. O preço final nunca é derivado disto
  /// automaticamente sem revisão humana.
  targetMarginPercent Decimal? @map("target_margin_percent") @db.Decimal(9, 4)

  costMethod        StockCostMethod @default(MEDIA_MOVIMENTACAO) @map("cost_method")
  /// Custo médio ponderado atual (mantido por job após cada entrada).
  averageCost       Decimal         @default(0) @map("average_cost") @db.Decimal(14, 4)
  lastPurchasePrice Decimal         @default(0) @map("last_purchase_price") @db.Decimal(14, 4)
  /// Estoque total de todas as filiais. Fonte da verdade: soma de `StockItem`.
  totalStock        Decimal         @default(0) @map("total_stock") @db.Decimal(14, 4)
  /// Saldo considerando apenas a filial ativa no contexto.
  currentStock      Decimal         @default(0) @map("current_stock") @db.Decimal(14, 4)

  minStock              Decimal               @default(0) @map("min_stock") @db.Decimal(14, 4)
  maxStock              Decimal               @default(0) @map("max_stock") @db.Decimal(14, 4)
  /// Estoque reservado por vendas ainda não faturadas.
  reservedStock         Decimal               @default(0) @map("reserved_stock") @db.Decimal(14, 4)
  allowNegativeStock    Boolean               @default(false) @map("allow_negative_stock")
  negativeStockBehavior StockNegativeBehavior @default(BLOQUEAR) @map("negative_stock_behavior")

  weightKg Decimal? @map("weight_kg") @db.Decimal(14, 4)
  lengthM  Decimal? @map("length_m") @db.Decimal(14, 4)
  widthM   Decimal? @map("width_m") @db.Decimal(14, 4)
  heightM  Decimal? @map("height_m") @db.Decimal(14, 4)

  // Dados fiscais. Regra: o contador define; o sistema apenas armazena e valida.
  ncmCode            String?        @map("ncm_code") @db.VarChar(12)
  cestCode           String?        @map("cest_code") @db.VarChar(10)
  productOrigin      ProductOrigin?
  /// Código Tributário do ICMS (CST/CSOSN). Varia por UF e por NCM.
  icmsTaxCode        String?        @map("icms_tax_code") @db.VarChar(20)
  /// Percentual de tributação federal (PIS/COFINS/IRPJ/CSLL/INSS) aplicado na
  /// venda. Não usamos os percentuais de 2024 em diante como "IBPT" porque
  /// cada produto tem o seu por NCM, CEST e origem.
  nationalTaxPercent Decimal?       @map("national_tax_percent") @db.Decimal(9, 4)
  importTaxPercent   Decimal?       @map("import_tax_percent") @db.Decimal(9, 4)
  /// Margem de Valor Agregado (MVA) da mercadoria, base do cálculo de ICMS ST.
  icmsStMvaPercent   Decimal?       @map("icms_st_mva_percent") @db.Decimal(9, 4)
  /// Fractionário para vendas interestaduais (apenas NFe/ECF). 0 = 1 inteiro.
  icmsStFraction     Int            @default(0) @map("icms_st_fraction")

  trackSerialNumber Boolean @default(false) @map("track_serial_number")
  trackBatch        Boolean @default(false) @map("track_batch")
  trackExpiryDate   Boolean @default(false) @map("track_expiry_date")
  /// Indices de controle interno.
  isAnalyzed        Boolean @default(false) @map("is_analyzed")
  salesCount        Int     @default(0) @map("sales_count")
  totalRevenue      Decimal @default(0) @map("total_revenue") @db.Decimal(14, 2)

  active        Boolean   @default(true)
  /// Data a partir da qual o produto pode ser vendido. NULL = imediato.
  availableFrom DateTime? @map("available_from")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  ncm      Ncm?      @relation(fields: [ncmCode], references: [code], onDelete: SetNull)

  stockItems         StockItem[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  inventoryItems     InventoryItem[]
  quoteItems         QuoteItem[]
  saleItems          SaleItem[]
  salesOrderItems    SalesOrderItem[]
  saleReturnItems    SaleReturnItem[]
  purchaseItems      PurchaseItem[]
  invoiceItems       InvoiceItem[]
  commissionItems    CommissionItem[]
  commissionRules    CommissionRule[]
  taxRules           TaxRule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, categoryId, active])
  @@index([tenantId, type, active])
  @@index([tenantId, ncmCode])
  @@index([tenantId, totalStock])
  @@index([branchId])
  @@map("products")
}

/// Serviços para NFS-e. Separado de `Product` porque a tributação, a
/// municipalidade e o provoke incidentam Logicamente.
model Service {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  branchId    String? @map("branch_id")
  categoryId  String? @map("category_id")
  unitId      String? @map("unit_id")
  code        String  @db.VarChar(60)
  name        String  @db.VarChar(200)
  description String?
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(14, 4)

  /// Código de enquadramento da LC 116/03. Specifica municipal.
  lc116Code      String?               @map("lc116_code") @db.VarChar(20)
  issRatePercent Decimal?              @map("iss_rate_percent") @db.Decimal(9, 4)
  issRetained    Boolean               @default(false) @map("iss_retained")
  incentiveType  ServiceIncentiveType?
  issExempt      Boolean               @default(false) @map("iss_exempt")

  /// Nacional (PIS/COFINS/IRPJ/CSLL/INSS) do serviço.
  nationalTaxPercent Decimal? @map("national_tax_percent") @db.Decimal(9, 4)
  /// Alíquotas IBS/CBS do serviço (Reforma Tributária). Versionadas em
  /// `TaxRule` quando o anexo exigir tratamento por grupo de serviço.
  cbsRatePercent     Decimal? @map("cbs_rate_percent") @db.Decimal(9, 4)
  ibsRatePercent     Decimal? @map("ibs_rate_percent") @db.Decimal(9, 4)

  /// Mapa municipal de tribute, ex.: "financ_...". Varia por município.
  municipalTaxMap       String?  @map("municipal_tax_map") @db.VarChar(60)
  /// Tributos federais retidos na fonte: pisRet, cofinsRet, csllRet, irpjRet, inssRet.
  pisRetainedPercent    Decimal? @map("pis_retained_percent") @db.Decimal(9, 4)
  cofinsRetainedPercent Decimal? @map("cofins_retained_percent") @db.Decimal(9, 4)
  csllRetainedPercent   Decimal? @map("csll_retained_percent") @db.Decimal(9, 4)
  irpjRetainedPercent   Decimal? @map("irpj_retained_percent") @db.Decimal(9, 4)
  INSSRetainedPercent   Decimal? @map("inss_retained_percent") @db.Decimal(9, 4)

  /// Igual a "municipalityId" do Company: onde o serviço é prestado.
  municipalityId String?  @map("municipality_id") @db.VarChar(7)
  estimatedHours Decimal? @map("estimated_hours") @db.Decimal(10, 2)
  cost           Decimal  @default(0) @db.Decimal(14, 4)
  active         Boolean  @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [ibgeCode], onDelete: SetNull)

  saleItems       SaleItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]
  quotes          QuoteItem[]
  taxRules        TaxRule[]
  saleReturnItems SaleReturnItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, active])
  @@index([branchId])
  @@index([municipalityId])
  @@map("services")
}

// ============================================================================
// CONDIÇÕES DE PAGAMENTO E FORMAS DE PAGAMENTO
// ============================================================================

model PaymentMethod {
  id                        String            @id @default(cuid())
  tenantId                  String            @map("tenant_id")
  branchId                  String?           @map("branch_id")
  code                      String            @db.VarChar(30)
  name                      String            @db.VarChar(80)
  type                      PaymentMethodType
  /// Bandeiras aceitas por esta forma (para PDV).
  brands                    String[]
  /// Requer integração com adquirente/PSP. Se true e sem gateway configurado,
  /// a operação registra o pagamento como PENDENTE.
  requiresGateway           Boolean           @default(false) @map("requires_gateway")
  gatewayKey                String?           @map("gateway_key") @db.VarChar(60)
  /// Troco é permitido? Só faz sentido para DINHEIRO.
  allowsChange              Boolean           @default(false) @map("allows_change")
  /// Exigir CPF/CNPJ do pagador acima deste valor (em centavos).
  requireDocumentAboveCents Int               @default(0) @map("require_document_above_cents")
  active                    Boolean           @default(true)
  sortOrder                 Int               @default(0) @map("sort_order")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales               Sale[]
  installments        Installment[]
  financialEntries    FinancialEntry[]
  cashMovements       CashMovement[]
  paymentTransactions PaymentTransaction[]
  saleSettlements     Settlement[]         @relation("SettlementPaymentMethod")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([branchId])
  @@map("payment_methods")
}

model PaymentTerms {
  id                     String           @id @default(cuid())
  tenantId               String           @map("tenant_id")
  branchId               String?          @map("branch_id")
  name                   String           @db.VarChar(100)
  type                   PaymentTermsType
  /// Para A_VISTA: 1. Para DIAS: 30. Para PARCELADO: número de parcelas.
  installmentCount       Int              @default(1) @map("installment_count")
  /// Dias entre parcelas (PARCELADO).
  intervalDays           Int              @default(0) @map("interval_days")
  /// Para DIA_FIXO: dia do mês (1..28 para evitar fim de mês inexistente).
  fixedDay               Int?             @map("fixed_day")
  /// Para CUSTOM: descrição livre.
  customDescription      String?          @map("custom_description") @db.VarChar(180)
  /// Desconto à vista em centavos.
  cashDiscountCents      Int              @default(0) @map("cash_discount_cents")
  /// Juros ao mês em percentual, para parcelamento com juros.
  interestPercentMonthly Decimal          @default(0) @map("interest_percent_monthly") @db.Decimal(9, 4)
  active                 Boolean          @default(true)

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customers          Customer[]
  sales              Sale[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  purchases          Purchase[]
  accountsReceivable AccountsReceivable[]
  accountsPayable    AccountsPayable[]
  invoices           Invoice[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([branchId])
  @@map("payment_terms")
}

// ============================================================================
// ESTOQUE
// ============================================================================

/// Saldo de estoque por produto e filial. É a fonte da verdade do saldo.
/// `quantity` nunca é alterada fora de `StockMovement` (via transação).
model StockItem {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  branchId  String @map("branch_id")
  productId String @map("product_id")

  quantity         Decimal @default(0) @db.Decimal(14, 4)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(14, 4)
  /// Custo médio do saldo (14,4). Recalculado por job após cada entrada.
  averageCost      Decimal @default(0) @map("average_cost") @db.Decimal(14, 4)
  /// Valor total do saldo (quantity * averageCost). Derivado.
  totalValue       Decimal @default(0) @map("total_value") @db.Decimal(14, 2)

  minStock          Decimal   @default(0) @map("min_stock") @db.Decimal(14, 4)
  maxStock          Decimal   @default(0) @map("max_stock") @db.Decimal(14, 4)
  /// Estoque reservado em trânsito (transferência entre filiais não recebida).
  inTransitQuantity Decimal   @default(0) @map("in_transit_quantity") @db.Decimal(14, 4)
  lastMovementAt    DateTime? @map("last_movement_at")
  lastCountedAt     DateTime? @map("last_counted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, quantity])
  @@index([tenantId, branchId, quantity])
  @@map("stock_items")
}

model StockMovement {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  branchId  String @map("branch_id")
  productId String @map("product_id")
  /// Ordem cronológica do movimento. Sem lacunas e monotonicamente crescente.
  sequence  BigInt @default(autoincrement()) @map("sequence")

  type             StockMovementType
  origin           StockMovementOrigin
  quantity         Decimal             @db.Decimal(14, 4)
  /// Positivo para entrada, negativo para saida.
  unitCost         Decimal             @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// Valor total do movimento. Derivado (quantity * unitCost).
  totalValue       Decimal             @default(0) @map("total_value") @db.Decimal(14, 2)
  /// Saldo do item imediatamente apos este movimento.
  balanceAfter     Decimal             @default(0) @map("balance_after") @db.Decimal(14, 4)
  averageCostAfter Decimal             @default(0) @map("average_cost_after") @db.Decimal(14, 4)

  documentType    String? @map("document_type") @db.VarChar(40)
  documentId      String? @map("document_id")
  documentNumber  String? @map("document_number") @db.VarChar(40)
  /// Fornecedor de origem (compras, devoluções, importações de XML).
  supplierId      String? @map("supplier_id")
  /// Transferência que gerou este movimento.
  transferId      String? @map("transfer_id")
  /// Item de inventário que originou o ajuste.
  inventoryItemId String? @unique @map("inventory_item_id")
  notes           String?
  /// Idempotencia: impede movimentacao duplicada em retry de request.
  idempotencyKey  String? @map("idempotency_key") @db.VarChar(120)
  performedById   String? @map("performed_by_id")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transfer      StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  /// Item de inventário que originou este ajuste. 1-1: um movimento de
  /// inventário pertence a no máximo um item.
  inventoryItem InventoryItem? @relation("InventoryMovement", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  performedBy   User?          @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, productId, createdAt])
  @@index([tenantId, documentType, documentId])
  @@index([tenantId, type, createdAt])
  @@index([productId, createdAt])
  @@index([supplierId])
  @@map("stock_movements")
}

model StockTransfer {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  originBranchId      String         @map("origin_branch_id")
  destinationBranchId String         @map("destination_branch_id")
  number              String         @db.VarChar(40)
  status              TransferStatus @default(RASCUNHO)

  requestedById String?   @map("requested_by_id")
  receivedById  String?   @map("received_by_id")
  sentAt        DateTime? @map("sent_at")
  receivedAt    DateTime? @map("received_at")
  notes         String?
  /// Transportadora / código de rastreio. Ferramenta externa.
  trackingCode  String?   @map("tracking_code") @db.VarChar(60)

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originBranch      Branch @relation("TransferOrigin", fields: [originBranchId], references: [id], onDelete: Cascade)
  destinationBranch Branch @relation("TransferDestination", fields: [destinationBranchId], references: [id], onDelete: Cascade)

  items     StockTransferItem[]
  movements StockMovement[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, originBranchId, destinationBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String  @id @default(cuid())
  transferId       String  @map("transfer_id")
  productId        String  @map("product_id")
  quantity         Decimal @db.Decimal(14, 4)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(14, 4)
  unitCost         Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)
  totalValue       Decimal @default(0) @map("total_value") @db.Decimal(14, 2)
  notes            String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("stock_transfer_items")
}

model Inventory {
  id       String          @id @default(cuid())
  tenantId String          @map("tenant_id")
  branchId String          @map("branch_id")
  number   String          @db.VarChar(40)
  name     String          @db.VarChar(140)
  type     InventoryType   @default(GERAL)
  status   InventoryStatus @default(RASCUNHO)

  categoryId    String?   @map("category_id")
  locationTag   String?   @map("location_tag") @db.VarChar(80)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  /// Contador de cegueira: se true, o sistema nao mostra o saldo esperado
  /// durante a contagem.
  blindCount    Boolean   @default(false) @map("blind_count")
  notes         String?
  performedById String?   @map("performed_by_id")
  approvedById  String?   @map("approved_by_id")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items InventoryItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, branchId, type])
  @@map("inventories")
}

model InventoryItem {
  id               String   @id @default(cuid())
  inventoryId      String   @map("inventory_id")
  productId        String   @map("product_id")
  /// Saldo do sistema no momento em que o item foi incluido.
  expectedQuantity Decimal  @default(0) @map("expected_quantity") @db.Decimal(14, 4)
  /// Quantidade contada fisicamente.
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(14, 4)
  /// Diferenca (counted - expected). Derivado, mas mantido para o relatorio.
  difference       Decimal? @db.Decimal(14, 4)
  differenceValue  Decimal  @default(0) @map("difference_value") @db.Decimal(14, 2)
  unitCost         Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 4)
  notes            String?

  inventory  Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  movement   StockMovement? @relation("InventoryMovement")
  movementId String?        @unique @map("movement_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("stock_inventory_items")
}

/// Sequencia numerica por empresa/filial/tipo. Numeração com `SELECT ... FOR
/// UPDATE` dentro de transação. Nunca usar `count() + 1`.
model NumberSequence {
  id               String  @id @default(cuid())
  tenantId         String  @map("tenant_id")
  branchId         String  @map("branch_id")
  /// Ex.: "SALE", "SALE_ORDER", "PURCHASE", "INVOICE_NFE", "CUSTOMER".
  model            String  @db.VarChar(40)
  /// Ano para séries resetáveis. 0 = série contínua.
  year             Int     @default(0)
  prefix           String? @db.VarChar(10)
  /// Series vigente de nota fiscal (0-999) e último número utilizado.
  lastNumber       Int     @default(0) @map("last_number")
  /// Salto configurado: 1 (normal) ou 5 (Resolução COTEC).
  step             Int     @default(1)
  /// Numeração de série da NF-e (válida 15 a 999).
  fiscalSeries     Int?    @map("fiscal_series")
  nextFiscalNumber Int?    @map("next_fiscal_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, branchId, model, year])
  @@index([tenantId, model])
  @@map("number_sequences")
}

// ============================================================================
// ORÇAMENTOS
// ============================================================================

model Quote {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  branchId   String      @map("branch_id")
  customerId String?     @map("customer_id")
  number     String      @db.VarChar(40)
  status     QuoteStatus @default(RASCUNHO)
  type       SaleType    @default(NORMAL)

  paymentTermsId String?   @map("payment_terms_id")
  validUntil     DateTime? @map("valid_until")
  notes          String?
  /// Texto livre que o vendedor escreve para o cliente.
  message        String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)
  /// Snapshot de todos os itens em JSON, para congelar o documento enviado.
  itemsSnapshot  Json?   @map("items_snapshot")

  sentAt        DateTime? @map("sent_at")
  acceptedAt    DateTime? @map("accepted_at")
  rejectedAt    DateTime? @map("rejected_at")
  convertedAt   DateTime? @map("converted_at")
  /// Venda gerada por este orçamento. 1-1: um orçamento converte uma vez.
  convertedToId String?   @unique @map("converted_to_id")
  createdById   String?   @map("created_by_id")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentTerms PaymentTerms? @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
  convertedTo  Sale?         @relation("QuoteConversion", fields: [convertedToId], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  createdBy    User?         @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@index([tenantId, status, validUntil])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id              String  @id @default(cuid())
  quoteId         String  @map("quote_id")
  productId       String? @map("product_id")
  serviceId       String? @map("service_id")
  description     String  @db.VarChar(255)
  quantity        Decimal @db.Decimal(14, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(14, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// Percentual total de impostos (ICMS + PIS + COFINS + ISS...) do item.
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(9, 4)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total           Decimal @default(0) @db.Decimal(14, 2)
  sortOrder       Int     @default(0) @map("sort_order")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@index([productId])
  @@index([serviceId])
  @@index([tenantId])
  @@map("quote_items")
}

// ============================================================================
// PEDIDOS DE VENDA
// ============================================================================

model SalesOrder {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  branchId   String      @map("branch_id")
  customerId String?     @map("customer_id")
  number     String      @db.VarChar(40)
  status     OrderStatus @default(PENDENTE)
  type       OrderType   @default(PEDIDO)
  channel    SaleChannel @default(BALCAO)

  paymentTermsId        String?   @map("payment_terms_id")
  requestedDeliveryDate DateTime? @map("requested_delivery_date")
  deliveryAddress       String?   @map("delivery_address")
  notes                 String?
  /// Referência externa (pedido vindo de marketplace, webhook, ERP legado).
  externalId            String?   @map("external_id")
  externalSource        String?   @map("external_source") @db.VarChar(40)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)
  itemsSnapshot  Json?   @map("items_snapshot")

  confirmedAt    DateTime? @map("confirmed_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdById    String?   @map("created_by_id")
  /// Chave de idempotência para evitar pedido duplicado de webhook.
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(120)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentTerms PaymentTerms?    @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
  items        SalesOrderItem[]
  sale         Sale?            @relation("OrderToSale")
  invoices     Invoice[]
  createdBy    User?            @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, requestedDeliveryDate])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId, createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                String  @id @default(cuid())
  orderId           String  @map("order_id")
  productId         String? @map("product_id")
  serviceId         String? @map("service_id")
  description       String  @db.VarChar(255)
  quantity          Decimal @db.Decimal(14, 4)
  unitPrice         Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxPercent        Decimal @default(0) @map("tax_percent") @db.Decimal(9, 4)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total             Decimal @default(0) @db.Decimal(14, 2)
  /// Quantidade já convertida em venda faturada.
  fulfilledQuantity Decimal @default(0) @map("fulfilled_quantity") @db.Decimal(14, 4)
  sortOrder         Int     @default(0) @map("sort_order")
  notes             String?

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  service Service?   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
  @@index([productId])
  @@index([serviceId])
  @@index([tenantId])
  @@map("sales_order_items")
}

// ============================================================================
// VENDAS
// ============================================================================

model Sale {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  branchId   String      @map("branch_id")
  customerId String?     @map("customer_id")
  /// Orçamento que originou a venda. 1-1: só um orçamento por venda.
  quoteId    String?     @unique @map("quote_id")
  /// Pedido que originou a venda.
  orderId    String?     @unique @map("order_id")
  number     String      @db.VarChar(40)
  series     String?     @db.VarChar(10)
  status     SaleStatus  @default(RASCUNHO)
  type       SaleType    @default(NORMAL)
  channel    SaleChannel @default(BALCAO)

  paymentTermsId  String? @map("payment_terms_id")
  paymentMethodId String? @map("payment_method_id")
  sellerId        String? @map("seller_id")

  /// Categoria do modelo 55 (NF-e). Varia a cada um ou mais de 3 meses.
  productCategory String? @map("product_category") @db.VarChar(4)
  purpose         String? @db.VarChar(120)

  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingAmount  Decimal @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  /// ICMS, PIS, COFINS, ISS, IBS, CBS e demais tributos da venda.
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// Valor dos tributos que incidem na operação (base de cálculo do item).
  grossTaxAmount  Decimal @default(0) @map("gross_tax_amount") @db.Decimal(14, 2)
  retentionAmount Decimal @default(0) @map("retention_amount") @db.Decimal(14, 2)
  /// Total já recebido, somado de `PaymentTransaction` aprovadas.
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)
  total           Decimal @default(0) @db.Decimal(14, 2)
  /// Custo dos produtos vendidos (para margem real). Derivado de StockMovement.
  costAmount      Decimal @default(0) @map("cost_amount") @db.Decimal(14, 2)
  /// Lucro bruto: total - tributos - custo.
  profitAmount    Decimal @default(0) @map("profit_amount") @db.Decimal(14, 2)
  itemsSnapshot   Json?   @map("items_snapshot")

  soldAt             DateTime? @map("sold_at")
  deliveredAt        DateTime? @map("delivered_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  notes              String?
  internalNotes      String?   @map("internal_notes")

  /// Chave de idempotência: impede venda duplicada no retry de request.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)
  createdById    String? @map("created_by_id")
  cancelledById  String? @map("cancelled_by_id")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentTerms  PaymentTerms?  @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  seller        User?          @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("SaleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Contraparte 1-1 do `Quote.convertedTo`.
  quote         Quote?         @relation("QuoteConversion")
  order         SalesOrder?    @relation("OrderToSale", fields: [orderId], references: [id], onDelete: SetNull)

  items              SaleItem[]
  payments           PaymentTransaction[]
  returns            SaleReturn[]
  invoices           Invoice[]
  accountsReceivable AccountsReceivable[]
  commissions        Commission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, soldAt])
  @@index([tenantId, customerId, soldAt])
  @@index([tenantId, sellerId, soldAt])
  @@index([tenantId, branchId, soldAt])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String  @map("sale_id")
  productId        String? @map("product_id")
  serviceId        String? @map("service_id")
  description      String  @db.VarChar(255)
  quantity         Decimal @db.Decimal(14, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// Percentual total de tributos do item (ICMS + PIS + COFINS + ISS + IBS + CBS).
  taxPercent       Decimal @default(0) @map("tax_percent") @db.Decimal(9, 4)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  /// Valor da operação base (para ST). Derivado do contexto fiscal.
  grossAmount      Decimal @default(0) @map("gross_amount") @db.Decimal(14, 2)
  total            Decimal @default(0) @db.Decimal(14, 2)
  /// Custo unitário no momento da venda. Congelado: não muda com o custo atual.
  unitCost         Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)
  costAmount       Decimal @default(0) @map("cost_amount") @db.Decimal(14, 2)
  /// Quantidade devolvida até o momento.
  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(14, 4)
  /// Quebras por NCM e total de tributos aproximados, calculados na emissão.
  ncmCode          String? @map("ncm_code") @db.VarChar(12)
  cestCode         String? @map("cest_code") @db.VarChar(10)
  cfop             String? @db.VarChar(8)
  icmsPercent      Decimal @default(0) @map("icms_percent") @db.Decimal(9, 4)
  pisPercent       Decimal @default(0) @map("pis_percent") @db.Decimal(9, 4)
  cofinsPercent    Decimal @default(0) @map("cofins_percent") @db.Decimal(9, 4)
  issPercent       Decimal @default(0) @map("iss_percent") @db.Decimal(9, 4)
  ibsPercent       Decimal @default(0) @map("ibs_percent") @db.Decimal(9, 4)
  cbsPercent       Decimal @default(0) @map("cbs_percent") @db.Decimal(9, 4)
  sortOrder        Int     @default(0) @map("sort_order")

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  service     Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  returnItems SaleReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([saleId, sortOrder])
  @@index([productId])
  @@index([serviceId])
  @@index([saleId, productId])
  @@index([tenantId])
  @@map("sale_items")
}

/// Transação de pagamento da venda. Uma venda pode ter varias (parcelas,
/// misto de cartão/dinheiro). Só `APROVADA` soma em `Sale.paidAmount`.
model PaymentTransaction {
  id                String                 @id @default(cuid())
  tenantId          String                 @map("tenant_id")
  saleId            String                 @map("sale_id")
  paymentMethodId   String?                @map("payment_method_id")
  installmentNumber Int                    @default(1) @map("installment_number")
  type              PaymentTransactionType @default(PENDENTE)
  amount            Decimal                @db.Decimal(14, 2)
  /// Troco devolvido ao cliente (apenas DINHEIRO).
  changeAmount      Decimal                @default(0) @map("change_amount") @db.Decimal(14, 2)
  /// Valor pago acima do total (para analysis de diferença).
  overpaymentAmount Decimal                @default(0) @map("overpayment_amount") @db.Decimal(14, 2)

  /// Identificador da transação no PSP/adquirente. Nunca guardar cartão.
  gatewayTransactionId String? @unique @map("gateway_transaction_id")
  gatewayName          String? @map("gateway_name") @db.VarChar(60)
  cardBrand            String? @map("card_brand") @db.VarChar(30)
  cardLastFour         String? @map("card_last_four") @db.VarChar(4)
  authorizationCode    String? @map("authorization_code") @db.VarChar(40)
  nsu                  String? @db.VarChar(30)
  acquirerMessage      String? @map("acquirer_message")

  /// Nota fiscal que recebeu este pagamento. NULL enquanto a venda não foi
  /// faturada (adiantamento do cliente).
  invoiceId String? @map("invoice_id")

  paidAt        DateTime? @map("paid_at")
  refundedAt    DateTime? @map("refunded_at")
  failureReason String?   @map("failure_reason")
  /// Comprovante: URL, XML ou PDF. Binário fica em storage externo.
  receiptUrl    String?   @map("receipt_url")

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, type, createdAt])
  @@index([saleId, type])
  @@index([tenantId, paidAt])
  @@map("payment_transactions")
}

model SaleReturn {
  id            String     @id @default(cuid())
  tenantId      String     @map("tenant_id")
  branchId      String     @map("branch_id")
  saleId        String     @map("sale_id")
  customerId    String?    @map("customer_id")
  number        String     @db.VarChar(40)
  type          ReturnType @default(PARCIAL)
  /// Motivo cadastrado (tabela `ReturnReason`), usado no relatório.
  reasonId      String?    @map("reason_id")
  /// Texto livre do motivo, quando não há motivo cadastrado.
  reasonDetails String?    @map("reason_details")

  subtotal               Decimal              @default(0) @db.Decimal(14, 2)
  discountAmount         Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount              Decimal              @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total                  Decimal              @default(0) @db.Decimal(14, 2)
  /// Valor efetivamente devolvido ao cliente.
  refundedAmount         Decimal              @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  /// Se a devolução gera nota fiscal de entrada (crédito). Sempre no fiscal.
  requiresFiscalDocument Boolean              @default(true) @map("requires_fiscal_document")
  status                 FinancialEntryStatus @default(PENDENTE)

  returnedAt   DateTime? @map("returned_at")
  approvedById String?   @map("approved_by_id")
  notes        String?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  returnReason ReturnReason?    @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  items        SaleReturnItem[]
  approvedBy   User?            @relation("SaleReturnApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@index([tenantId, saleId])
  @@index([tenantId, status, returnedAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id             String  @id @default(cuid())
  returnId       String  @map("return_id")
  saleItemId     String  @map("sale_item_id")
  productId      String? @map("product_id")
  serviceId      String? @map("service_id")
  description    String  @db.VarChar(255)
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)
  unitCost       Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)
  /// Reentrada em estoque: o item volta como movimento de devolução.
  restock        Boolean @default(true)
  cfop           String? @db.VarChar(8)
  ncmCode        String? @map("ncm_code") @db.VarChar(12)

  return   SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product  Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  service  Service?   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@index([serviceId])
  @@index([tenantId])
  @@map("sale_return_items")
}

/// Motivo de devolução, com vinculo opcional à NVe. A lista segue a
/// Tabela de Motivos da NF-e quando aplicável.
model ReturnReason {
  id                String  @id @default(cuid())
  tenantId          String  @map("tenant_id")
  code              String  @db.VarChar(10)
  name              String  @db.VarChar(120)
  /// Motivo fiscal correspondente quando a devolução gerar nota de crédito.
  /// Vazio para motivos internos que não chegam ao fisco.
  fiscalCode        String? @map("fiscal_code") @db.VarChar(4)
  /// Devolução restitui o valor ao cliente?
  refundsValue      Boolean @default(true) @map("refunds_value")
  /// Devolução gera entrada de estoque?
  restocksInventory Boolean @default(true) @map("restocks_inventory")
  active            Boolean @default(true)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  returns SaleReturn[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("return_reasons")
}

// ============================================================================
// COMISSÕES
// ============================================================================

/// Regra de comissão por produto, categoria ou vendedor. Definida pela
/// empresa; o cálculo usa apenas o que está gravado aqui.
model CommissionRule {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  branchId        String?        @map("branch_id")
  name            String         @db.VarChar(140)
  description     String?
  productId       String?        @map("product_id")
  categoryId      String?        @map("category_id")
  sellerId        String?        @map("seller_id")
  base            CommissionBase @default(VALOR_LIQUIDO_ITEM)
  /// Percentual sobre a base (ex.: 5.0000 = 5%).
  percent         Decimal        @db.Decimal(9, 4)
  /// Valor fixo por item vendido, somado ao percentual.
  fixedAmount     Decimal        @default(0) @map("fixed_amount") @db.Decimal(14, 2)
  /// Aplicar a partir de X unidades vendidas no mês.
  minimumQuantity Decimal?       @map("minimum_quantity") @db.Decimal(14, 4)
  validFrom       DateTime?      @map("valid_from")
  validTo         DateTime?      @map("valid_to")
  active          Boolean        @default(true)
  createdById     String?        @map("created_by_id")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seller    User?     @relation("CommissionRuleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, active])
  @@index([tenantId, sellerId])
  @@index([tenantId, productId])
  @@map("commission_rules")
}

model Commission {
  id       String           @id @default(cuid())
  tenantId String           @map("tenant_id")
  branchId String?          @map("branch_id")
  saleId   String?          @map("sale_id")
  sellerId String           @map("seller_id")
  status   CommissionStatus @default(PENDENTE)
  period   String           @db.Char(7)

  baseAmount       Decimal @default(0) @map("base_amount") @db.Decimal(14, 2)
  percent          Decimal @default(0) @db.Decimal(9, 4)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(14, 2)
  /// Descontos/estornos já aplicados sobre comissões do período.
  deductionAmount  Decimal @default(0) @map("deduction_amount") @db.Decimal(14, 2)
  netAmount        Decimal @default(0) @map("net_amount") @db.Decimal(14, 2)
  paidAmount       Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  dueDate DateTime? @map("due_date")
  paidAt  DateTime? @map("paid_at")
  notes   String?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sale   Sale?            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  seller User             @relation("CommissionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  items  CommissionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, sellerId, saleId, period])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, period, status])
  @@index([sellerId])
  @@map("commissions")
}

model CommissionItem {
  id           String  @id @default(cuid())
  commissionId String  @map("commission_id")
  productId    String? @map("product_id")
  saleItemId   String? @map("sale_item_id")
  baseAmount   Decimal @default(0) @map("base_amount") @db.Decimal(14, 2)
  percent      Decimal @default(0) @db.Decimal(9, 4)
  amount       Decimal @default(0) @db.Decimal(14, 2)

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([productId])
  @@index([tenantId])
  @@map("commission_items")
}

// ============================================================================
// PLANO DE CONTAS E CENTROS DE CUSTO
// ============================================================================

/// Plano de contas próprio da empresa. Números estruturados (ex.: "1.1.01.001").
/// O código de uma conta pode ser edited, mas o `type` NÃO: mudar o tipo de
/// uma conta já movimentada quebra o DRE. Nesse caso, crie outra conta.
model ChartOfAccount {
  id                    String        @id @default(cuid())
  tenantId              String        @map("tenant_id")
  branchId              String?       @map("branch_id")
  code                  String        @db.VarChar(20)
  name                  String        @db.VarChar(180)
  type                  AccountType
  nature                AccountNature
  parentId              String?       @map("parent_id")
  /// Conta aceita lançamentos diretamente? false = apenas agrupadora.
  isPostable            Boolean       @default(true) @map("is_postable")
  /// Conta de resultado (entra no DRE).
  isProfitAndLoss       Boolean       @default(false) @map("is_profit_and_loss")
  /// Conta exigida no ECF / sped (ECD, ECF, EFD ICMS/IPI).
  isSpedAccount         Boolean       @default(false) @map("is_sped_account")
  /// Código do grupo no SPED. Ex.: "1.01" = group de availability.
  spedGroupCode         String?       @map("sped_group_code") @db.VarChar(20)
  /// Compatível com a conta padrão do contador (ex.: conta 1.1.01.001).
  compatibleAccountCode String?       @map("compatible_account_code") @db.VarChar(20)
  active                Boolean       @default(true)
  notes                 String?

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent             ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           ChartOfAccount[] @relation("AccountTree")
  entries            FinancialEntry[] @relation("SourceAccount")
  destinationEntries FinancialEntry[] @relation("DestinationAccount")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, isProfitAndLoss])
  @@map("chart_of_accounts")
}

model CostCenter {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  branchId    String? @map("branch_id")
  code        String  @db.VarChar(20)
  name        String  @db.VarChar(140)
  description String?
  active      Boolean @default(true)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entries FinancialEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("cost_centers")
}

/// Lançamento financeiro (lançamentos de caixa, contas a pagar/receber e
/// Transferências). Campos derivados: `amount` nunca é recalculado.
model FinancialEntry {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  branchId    String               @map("branch_id")
  type        FinancialEntryType
  status      FinancialEntryStatus @default(PENDENTE)
  description String               @db.VarChar(255)
  notes       String?

  /// Conta de origem (débito) e destino (crédito).
  sourceAccountId      String  @map("source_account_id")
  destinationAccountId String  @map("destination_account_id")
  costCenterId         String? @map("cost_center_id")
  bankAccountId        String? @map("bank_account_id")
  paymentMethodId      String? @map("payment_method_id")

  amount          Decimal @db.Decimal(14, 2)
  /// Saldo pendente (amount - paidAmount). Derivado.
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(14, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  dueDate        DateTime  @map("due_date")
  settledDate    DateTime? @map("settled_date")
  /// Data de competência contábil (pode diferir do vencimento).
  competenceDate DateTime  @map("competence_date")

  /// Documento de origem (nota, venda, compra, folha).
  documentType        String?                  @map("document_type") @db.VarChar(40)
  documentId          String?                  @map("document_id")
  documentNumber      String?                  @map("document_number") @db.VarChar(40)
  /// Chave de idempotência.
  idempotencyKey      String?                  @map("idempotency_key") @db.VarChar(120)
  createdById         String?                  @map("created_by_id")
  settledById         String?                  @map("settled_by_id")
  isRecurring         Boolean                  @default(false) @map("is_recurring")
  recurrenceRule      String?                  @map("recurrence_rule") @db.VarChar(120)
  reconciliationItems BankReconciliationItem[] @relation("ReconciliationEntry")

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sourceAccount      ChartOfAccount @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount ChartOfAccount @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  costCenter         CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  bankAccount        BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  settlements        Settlement[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, competenceDate])
  @@index([tenantId, documentType, documentId])
  @@index([tenantId, type, dueDate])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([costCenterId])
  @@index([bankAccountId])
  @@map("financial_entries")
}

model Settlement {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  entryId         String           @map("entry_id")
  action          SettlementAction
  amount          Decimal          @db.Decimal(14, 2)
  settledAt       DateTime         @default(now()) @map("settled_at")
  bankAccountId   String?          @map("bank_account_id")
  paymentMethodId String?          @map("payment_method_id")
  notes           String?
  /// Comprovante (PDF, XML ou URL). Nunca dados de cartão.
  receiptUrl      String?          @map("receipt_url")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry         FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation("SettlementPaymentMethod", fields: [paymentMethodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entryId])
  @@index([tenantId, settledAt])
  @@index([bankAccountId])
  @@index([paymentMethodId])
  @@map("settlements")
}

model BankAccount {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  branchId         String?         @map("branch_id")
  /// Conta do plano de contas que representa o caixa/banco.
  chartOfAccountId String          @map("chart_of_account_id")
  name             String          @db.VarChar(140)
  type             BankAccountType @default(CONTA_CORRENTE)
  bankName         String?         @db.VarChar(120)
  bankCode         String?         @map("bank_code") @db.VarChar(10)
  agency           String?         @db.VarChar(20)
  agencyDigit      String?         @map("agency_digit") @db.VarChar(4)
  accountNumber    String?         @map("account_number") @db.VarChar(30)
  accountDigit     String?         @map("account_digit") @db.VarChar(4)
  openingBalance   Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance   Decimal         @default(0) @map("current_balance") @db.Decimal(14, 2)
  isDefault        Boolean         @default(false) @map("is_default")
  active           Boolean         @default(true)
  notes            String?

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entries         FinancialEntry[]
  settlements     Settlement[]
  cashMovements   CashMovement[]
  reconciliations BankReconciliation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@index([branchId])
  @@map("bank_accounts")
}

/// Conciliação bancária. O ERP não conecta ao banco por conta própria; a
/// importação de extrato é por arquivo (OFX, CSV, XLSX) ou API do banco.
model BankReconciliation {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  bankAccountId  String    @map("bank_account_id")
  period         String    @db.Char(7)
  status         JobStatus @default(PENDING)
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal   @default(0) @map("closing_balance") @db.Decimal(14, 2)
  reconciledAt   DateTime? @map("reconciled_at")
  reconciledById String?   @map("reconciled_by_id")
  notes          String?

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  items       BankReconciliationItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bankAccountId, period])
  // Indice nao redundante com o `@@unique` acima (que comeca por
  // bank_account_id). A extensao de tenant filtra por `tenant_id` em TODA
  // query; sem este indice a listagem de conciliacoes da empresa vira
  // table scan.
  @@index([tenantId])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id                    String    @id @default(cuid())
  reconciliationId      String    @map("reconciliation_id")
  entryId               String?   @map("entry_id")
  /// Linha do extrato importado (para rastreabilidade quando divergente).
  externalTransactionId String?   @map("external_transaction_id")
  description           String    @db.VarChar(255)
  amount                Decimal   @db.Decimal(14, 2)
  transactionDate       DateTime  @map("transaction_date")
  reconciled            Boolean   @default(false)
  reconciledAt          DateTime? @map("reconciled_at")

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  entry          FinancialEntry?    @relation("ReconciliationEntry", fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@index([entryId])
  @@index([tenantId])
  @@map("bank_reconciliation_items")
}

// ============================================================================
// CONTAS A RECEBER E A PAGAR
