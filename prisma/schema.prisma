  accountsPayable    AccountsPayable?    @relation(fields: [accountsPayableId], references: [id], onDelete: Cascade)
  paymentMethod      PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status, dueDate])
  @@index([accountsReceivableId])
  @@index([accountsPayableId])
  @@index([branchId])
  @@map("installments")
}

// ============================================================================
// COMPRAS
// ============================================================================

model Purchase {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  branchId       String         @map("branch_id")
  supplierId     String?        @map("supplier_id")
  number         String         @db.VarChar(40)
  type           PurchaseType   @default(PEDIDO)
  status         PurchaseStatus @default(RASCUNHO)
  paymentTermsId String?        @map("payment_terms_id")
  sellerId       String?        @map("seller_id")

  /// Chave de acesso do documento fiscal de entrada (NFe/NFCe modelo 55).
  /// Base do controle de duplicidade: uma mesma chave não entra duas vezes.
  fiscalAccessKey String?   @map("fiscal_access_key") @db.VarChar(44)
  /// XML do documento de entrada, para auditoria e reimportação.
  fiscalXmlUrl    String?   @map("fiscal_xml_url")
  orderDate       DateTime  @map("order_date")
  receivedDate    DateTime? @map("received_date")

  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingAmount  Decimal @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  retentionAmount Decimal @default(0) @map("retention_amount") @db.Decimal(14, 2)
  total           Decimal @default(0) @db.Decimal(14, 2)
  notes           String?

  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)
  createdById    String? @map("created_by_id")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentTerms    PaymentTerms?     @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
  seller          User?             @relation("PurchaseSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items           PurchaseItem[]
  accountsPayable AccountsPayable[]
  invoices        Invoice[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, number])
  @@unique([tenantId, fiscalAccessKey])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, supplierId, orderDate])
  @@index([tenantId, branchId, orderDate])
  @@map("purchases")
}

model PurchaseItem {
  id                   String  @id @default(cuid())
  purchaseId           String  @map("purchase_id")
  productId            String? @map("product_id")
  description          String  @db.VarChar(255)
  quantity             Decimal @db.Decimal(14, 4)
  unitPrice            Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount       Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxPercent           Decimal @default(0) @map("tax_percent") @db.Decimal(9, 4)
  taxAmount            Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total                Decimal @default(0) @db.Decimal(14, 2)
  /// Unidade de compra (caixa com 12) diferente da unidade de venda (unidade).
  purchaseUnitQuantity Decimal @default(1) @map("purchase_unit_quantity") @db.Decimal(14, 4)
  /// Valor líquido de tributos que pode ser aproveitado como crédito.
  creditableTaxAmount  Decimal @default(0) @map("creditable_tax_amount") @db.Decimal(14, 2)
  /// Percentual do crédito aproveitável pela empresa.
  creditableTaxPercent Decimal @default(0) @map("creditable_tax_percent") @db.Decimal(9, 4)
  cfop                 String? @db.VarChar(8)
  ncmCode              String? @map("ncm_code") @db.VarChar(12)
  sortOrder            Int     @default(0) @map("sort_order")
  notes                String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([purchaseId, sortOrder])
  @@index([productId])
  @@index([tenantId])
  @@map("purchase_items")
}

