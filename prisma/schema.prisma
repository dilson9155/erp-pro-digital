/// Parcela de contas a receber/pagar. Uma venda parcelada gera N parcelas.
model Installment {
  id                   String            @id @default(cuid())
  tenantId             String            @map("tenant_id")
  branchId             String?           @map("branch_id")
  accountsReceivableId String?           @map("accounts_receivable_id")
  accountsPayableId    String?           @map("accounts_payable_id")
  paymentMethodId      String?           @map("payment_method_id")
  number               Int
  total                Int
  status               InstallmentStatus @default(PENDENTE)

  amount          Decimal @db.Decimal(14, 2)
  interestAmount  Decimal @default(0) @map("interest_amount") @db.Decimal(14, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(14, 2)

  dueDate           DateTime  @map("due_date")
  paidAt            DateTime? @map("paid_at")
