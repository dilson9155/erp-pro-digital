model CashRegister {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  branchId         String             @map("branch_id")
  name             String             @db.VarChar(120)
  status           CashRegisterStatus @default(FECHADO)
  openedAt         DateTime?          @map("opened_at")
  closedAt         DateTime?          @map("closed_at")
  openingAmount    Decimal            @default(0) @map("opening_amount") @db.Decimal(14, 2)
  /// Total apurado no fechamento (soma dos movimentos + abertura).
  closingAmount    Decimal            @default(0) @map("closing_amount") @db.Decimal(14, 2)
  /// Diferença apurada: closingAmount - (sistema esperado).
  differenceAmount Decimal            @default(0) @map("difference_amount") @db.Decimal(14, 2)
  expectedAmount   Decimal            @default(0) @map("expected_amount") @db.Decimal(14, 2)
  countedAmount    Decimal            @default(0) @map("counted_amount") @db.Decimal(14, 2)
  notes            String?
  openedById       String?            @map("opened_by_id")
  closedById       String?            @map("closed_by_id")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedBy  User?          @relation("CashRegisterOpener", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy  User?          @relation("CashRegisterCloser", fields: [closedById], references: [id], onDelete: SetNull)
  movements CashMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, branchId, name])
  @@index([tenantId, status])
  @@index([branchId])
  @@map("cash_registers")
}

model CashMovement {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  branchId        String                @map("branch_id")
  cashRegisterId  String                @map("cash_register_id")
  bankAccountId   String?               @map("bank_account_id")
  paymentMethodId String?               @map("payment_method_id")
  type            CashMovementType
  direction       CashMovementDirection
  amount          Decimal               @db.Decimal(14, 2)
  description     String                @db.VarChar(255)
  documentType    String?               @map("document_type") @db.VarChar(40)
  documentId      String?               @map("document_id")
  documentNumber  String?               @map("document_number") @db.VarChar(40)
  notes           String?
  movedAt         DateTime              @default(now()) @map("moved_at")
  createdById     String?               @map("created_by_id")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashRegister  CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("CashMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, cashRegisterId, movedAt])
  @@index([tenantId, type, movedAt])
  @@index([branchId])
  @@index([bankAccountId])
  @@index([createdById])
  @@map("cash_movements")
}

// ============================================================================
// FISCAL — NF-e, NFC-e e NFS-e
//
// REGRA INEGOCIÁVEL DESTA SEÇÃO
//
// Nenhuma regra fiscal é codificada na aplicação. Alíquota, CFOP, CST,
// código de beneficiário da UF, forma de emissão, tipo de contingência e versão
// de layout são LIDOS de `FiscalConfig`/`TaxRule` e enviados ao provedor. O
// provedor é quem valida contra a NT e o schema vigente. A aplicação apenas
// orquestra, registra e apresenta o que o autorizador respondeu.
// ============================================================================

/// Integração fiscal de UMA empresa. Credenciais cifradas em repouso por
/// `src/server/modules/fiscal/crypto.ts` (AES-256-GCM). Nunca em texto puro.
model FiscalIntegration {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  providerId  String            @map("provider_id")
  environment FiscalEnvironment @default(HOMOLOGACAO)
  name        String            @db.VarChar(120)
  active      Boolean           @default(true)
  isDefault   Boolean           @default(false) @map("is_default")

  /// Segredos cifrados. Tipos distintos porque nem todo provedor usa todos.
  clientIdEncrypted     String?   @map("client_id_encrypted")
  clientSecretEncrypted String?   @map("client_secret_encrypted")
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  /// Token do webhook de retorno do autorizador.
  webhookTokenEncrypted String?   @map("webhook_token_encrypted")

  /// ID do cadastro no provedor (ex.: CNPJ da empresa no provedor).
  externalId       String?   @map("external_id")
  lastTestedAt     DateTime? @map("last_testeded_at")
  lastTestOk       Boolean?  @map("last_test_ok")
  lastErrorMessage String?   @map("last_error_message")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider FiscalProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  configs  FiscalConfig[]
  logs     FiscalLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, providerId, environment])
  @@index([tenantId, active, isDefault])
  @@map("fiscal_integrations")
}

/// Configuração fiscal por filial: série, CFOP padrão, forma de emissão,
/// contingencia, imprimante, natureza da operação, identificador local.
model FiscalConfig {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  branchId      String            @map("branch_id")
  integrationId String            @map("integration_id")
  model         InvoiceModel
  environment   FiscalEnvironment @default(HOMOLOGACAO)
  active        Boolean           @default(true)

  /// Série vigente (NF-e/NFC-e: 1-999; NFS-e: texto livre por município).
  series                    String? @db.VarChar(10)
  /// CFOP padrão para saída de mercadoria/serviço.
  defaultCfopOut            String? @map("default_cfop_out") @db.VarChar(8)
  defaultCfopIn             String? @map("default_cfop_in") @db.VarChar(8)
  /// Natureza da operação (ex.: "VENDA DE MERCADORIA ADQUIRIDA DE TERCEIROS").
  operationNature           String? @map("operation_nature") @db.VarChar(120)
  /// Indicador de presença (idPres=1..5) quando o cliente é consumidor final.
  consumerPresenceIndicator Int?    @map("consumer_presence_indicator")
  /// Código do município de ocorrência do fato gerador (IBGE).
  municipalityCode          String? @map("municipality_code") @db.VarChar(7)
  /// Telefone da empresa (obrigatório na NF-e, tagenderPhone).
  contactPhone              String? @map("contact_phone") @db.VarChar(20)
  contactEmail              String? @map("contact_email") @db.VarChar(180)
  contactName               String? @map("contact_name") @db.VarChar(120)

  /// Impressão: DANFE em A4, formatura de segurança, emitente autorizado.
  danfeFormat       String? @map("danfe_format") @db.VarChar(20)
  danfeSecurityForm String? @map("danfe_security_form") @db.VarChar(20)
  danfePrinterName  String? @map("danfe_printer_name") @db.VarChar(120)
  danfeCopies       Int     @default(1) @map("danfe_copies")
  /// Enviar XML por e-mail automaticamente após autorização.
  sendXmlByEmail    Boolean @default(false) @map("send_xml_by_email")
  /// Usar homologação para todos os testes do próprio cliente.
  isTestMode        Boolean @default(false) @map("is_test_mode")

  /// Contingência: o tipo de JE que será acionado e se está ativa.
  contingencyType          String?   @map("contingency_type") @db.VarChar(40)
  contingencyJustification String?   @map("contingency_justification")
  contingencyActive        Boolean   @default(false) @map("contingency_active")
  contingencyActiveAt      DateTime? @map("contingency_active_at")
  contingencyEndsAt        DateTime? @map("contingency_ends_at")

  /// Idempotência de emissão (evita duplicar em retry).
  notes String?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  integration FiscalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  series_     FiscalSeries[]
  taxRules    TaxRule[]
  invoices    Invoice[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId, model, environment])
  @@index([tenantId, active])
  @@map("fiscal_configs")
}

/// Série de documento fiscal com controle de numeração e de
/// inutilização. Uma série é liberada (envio em lote de autorização) antes do
/// primeiro documento, conforme protocolo do autorizador.
model FiscalSeries {
  id                       String            @id @default(cuid())
  tenantId                 String            @map("tenant_id")
  branchId                 String            @map("branch_id")
  fiscalConfigId           String            @map("fiscal_config_id")
  model                    InvoiceModel
  series                   String            @db.VarChar(10)
  environment              FiscalEnvironment @default(PRODUCAO)
  /// Ultimo numero utilizado nesta série (liberado no autorizador).
  lastNumber               Int               @default(0) @map("last_number")
  /// Proximo numero a usar. NUNCA `count()+1`.
  nextNumber               Int               @default(1) @map("next_number")
  /// Numeraçãoconventional ou de contingência com salto.
  isContingency            Boolean           @default(false) @map("is_contingency")
  /// Autorização de uso da série: data/hora/protocolo/digest.
  authorizedAt             DateTime?         @map("authorized_at")
  authorizationProtocol    String?           @map("authorization_protocol") @db.VarChar(60)
  authorizationDigestValue String?           @map("authorization_digest_value") @db.VarChar(60)
  /// Faixa authorized pelo autorizador.
  authorizedFrom           Int?              @map("authorized_from")
  authorizedTo             Int?              @map("authorized_to")
  /// Aproximação deNumbers disponíveis.
  availableFrom            Int?              @map("available_from")
  availableTo              Int?              @map("available_to")
  active                   Boolean           @default(true)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalConfig FiscalConfig @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, branchId, model, series, environment])
  @@index([tenantId, model, active])
  @@map("fiscal_series")
}

/// Certificado digital A1 do emissor. O arquivo `.pfx` NUNCA fica no banco:
/// só a chave privada cifrada e o caminho no storage. Pkcs12 tem data de
/// expiração; o job de rotina alerta antes.
model Certificate {
  id       String            @id @default(cuid())
  tenantId String            @map("tenant_id")
  branchId String?           @map("branch_id")
  name     String            @db.VarChar(140)
  type     String            @default("A1") @db.VarChar(4)
  status   CertificateStatus @default(VALIDO)

  /// Bytes do PKCS#12 cifrados (AES-256-GCM). NULL se o arquivo estiver só no
  /// storage externo e `storagePath` for a fonte.
  pfxEncrypted      String? @map("pfx_encrypted")
  storagePath       String? @map("storage_path")
  passwordEncrypted String? @map("password_encrypted")
  /// SHA-256 do arquivo, para detectar troca indevida.
  checksum          String? @db.VarChar(64)

  subjectName   String?  @map("subject_name") @db.VarChar(200)
  issuerName    String?  @map("issuer_name") @db.VarChar(200)
  serialNumber  String?  @map("serial_number") @db.VarChar(80)
  validFrom     DateTime @map("valid_from")
  validUntil    DateTime @map("valid_until")
  /// CPF/CNPJ do titular do certificado, se extraído do arquivo.
  ownerDocument String?  @map("owner_document") @db.VarChar(18)

  notes String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, status])
  @@index([tenantId, validUntil])
  @@index([branchId])
  @@map("certificates")
}

/// Regra de tributação versionada por vigência. Carrega ICMS, PIS, COFINS,
/// ISS, IBS e CBS. Regras de 2026 (Reforma Tributária) coexistem com as de
/// 2025 porque o período de transição exige as duas no mesmo banco. Nenhuma
/// alíquota é padrão no código.
model TaxRule {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  branchId       String? @map("branch_id")
  fiscalConfigId String? @map("fiscal_config_id")
  name           String  @db.VarChar(140)
  description    String?

  /// Escopo da regra.
  state         BrazilState?
  ncmCode       String?        @map("ncm_code") @db.VarChar(12)
  cestCode      String?        @map("cest_code") @db.VarChar(10)
  productId     String?        @map("product_id")
  productOrigin ProductOrigin?
  serviceId     String?        @map("service_id")
  cfop          String?        @db.VarChar(8)
  /// Grupo da reforma (ex.: "mercadoria", "serviço" para IBS/CBS).
  taxGroup      String?        @map("tax_group") @db.VarChar(60)

  /// CST/CSOSN aplicável. Lido do cadastro, nunca deduzido.
  icmsTaxCode         String?  @map("icms_tax_code") @db.VarChar(20)
  icmsRatePercent     Decimal? @map("icms_rate_percent") @db.Decimal(9, 4)
  /// Redução de base do ICMS (ex.: 40% para cesta básica alimentar).
  icmsRedutionPercent Decimal? @map("icms_reduction_percent") @db.Decimal(9, 4)
  icmsStRatePercent   Decimal? @map("icms_st_rate_percent") @db.Decimal(9, 4)
  icmsStMvaPercent    Decimal? @map("icms_st_mva_percent") @db.Decimal(9, 4)

  pisTaxCode        String?  @map("pis_tax_code") @db.VarChar(20)
  pisRatePercent    Decimal? @map("pis_rate_percent") @db.Decimal(9, 4)
  cofinsTaxCode     String?  @map("cofins_tax_code") @db.VarChar(20)
  cofinsRatePercent Decimal? @map("cofins_rate_percent") @db.Decimal(9, 4)
  ipiRatePercent    Decimal? @map("ipi_rate_percent") @db.Decimal(9, 4)
  issRatePercent    Decimal? @map("iss_rate_percent") @db.Decimal(9, 4)

  /// Reforma Tributária (LC 214/2025). Vigência controlada por
  /// `validFrom`/`validTo`, sem alteração de schema.
  ibsRatePercent          Decimal? @map("ibs_rate_percent") @db.Decimal(9, 4)
  cbsRatePercent          Decimal? @map("cbs_rate_percent") @db.Decimal(9, 4)
  importTaxRatePercent    Decimal? @map("import_tax_rate_percent") @db.Decimal(9, 4)
  selectiveTaxRatePercent Decimal? @map("selective_tax_rate_percent") @db.Decimal(9, 4)

  /// Vigência. `validTo` NULL = vigente.
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  priority  Int       @default(0)
  active    Boolean   @default(true)
  notes     String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalConfig FiscalConfig? @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, active])
  @@index([tenantId, validFrom, validTo])
  @@index([tenantId, state, ncmCode])
  @@index([productId])
  @@index([serviceId])
  @@map("tax_rules")
}

/// Nota fiscal emitida (saída) ou recebida (entrada, `direction` IN). Um
/// único model serve a NF-e, NFC-e e NFS-e: os campos de transporte e
/// protocolo só existem em NF-e/NFC-e, e os de serviço só em NFS-e.
model Invoice {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  branchId       String  @map("branch_id")
  fiscalConfigId String? @map("fiscal_config_id")
  fiscalSeriesId String? @map("fiscal_series_id")

  /// Documento comercial que originou a nota (venda, pedido, compra).
  saleId                  String?           @map("sale_id")
  orderId                 String?           @map("order_id")
  purchaseId              String?           @map("purchase_id")
  /// Fornecedor de origem, para notas de ENTRADA (modelo 55 recebida).
  supplierId              String?           @map("supplier_id")
  paymentTermsId          String?           @map("payment_terms_id")
  /// Nota de origem, quando esta é uma nota de entrada, correção ou
  /// complementar. NULL para emissão própria.
  referenceInvoiceId      String?           @map("reference_invoice_id")
  /// Natureza da operação para este documento (ajuste pontual por nota).
  operationNatureOverride String?           @map("operation_nature_override") @db.VarChar(120)
  model                   InvoiceModel
  direction               FiscalDirection   @default(OUT)
  status                  FiscalStatus      @default(RASCUNHO)
  environment             FiscalEnvironment @default(HOMOLOGACAO)

  /// Número e série internos. `number` é alocado por `FiscalSeries`.
  number                Int
  series                String?   @db.VarChar(10)
  /// Chave de acesso (44 dígitos) preenchida após autorização.
  accessKey             String?   @unique @db.VarChar(44)
  /// Chave de acesso de consulta (chNFe +versão 4.00).
  queryKey              String?   @map("query_key") @db.VarChar(60)
  /// Token do recibo do autorizador.
  receiptToken          String?   @map("receipt_token") @db.VarChar(20)
  /// Data/hora de autorização e protocolo.
  authorizedAt          DateTime? @map("authorized_at")
  authorizationProtocol String?   @map("authorization_protocol") @db.VarChar(60)
  authorizationDigest   String?   @map("authorization_digest") @db.VarChar(80)
  /// Protocolo de DENEGA, se aplicável.
  denialReason          String?   @map("denial_reason")
  denialProtocol        String?   @map("denial_protocol") @db.VarChar(60)

  /// Dados do destinatário/remetente, congelados no XML.
  customerId                String?            @map("customer_id")
  customerName              String             @map("customer_name") @db.VarChar(180)
  customerDocument          String?            @map("customer_document") @db.VarChar(18)
  customerDocumentRaw       String?            @map("customer_document_raw") @db.VarChar(20)
  customerEmail             String?            @map("customer_email") @db.VarChar(180)
  customerStateRegistration String?            @map("customer_state_registration") @db.VarChar(20)
  customerAddressKind       FiscalAddressKind?
  customerCountryCode       String?            @map("customer_country_code") @db.VarChar(60)
  customerStreet            String?            @map("customer_street") @db.VarChar(150)
  customerStreetNumber      String?            @map("customer_street_number") @db.VarChar(20)
  customerStreetComplement  String?            @map("customer_street_complement") @db.VarChar(80)
  customerDistrict          String?            @map("customer_district") @db.VarChar(80)
  customerCity              String?            @map("customer_city") @db.VarChar(100)
  customerState             BrazilState?
  customerZipCode           String?            @map("customer_zip_code") @db.VarChar(8)
  customerCountryId         String?            @map("customer_country_id") @db.VarChar(20)
  customerPhone             String?            @map("customer_phone") @db.VarChar(20)

  /// Totais. Subtotais separados para o cálculo dos tributos Federais.
  subtotal          Decimal @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingAmount    Decimal @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  totalProducts     Decimal @default(0) @map("total_products") @db.Decimal(14, 2)
  totalServices     Decimal @default(0) @map("total_services") @db.Decimal(14, 2)
  icmsTotal         Decimal @default(0) @map("icms_total") @db.Decimal(14, 2)
  ipiTotal          Decimal @default(0) @map("ipi_total") @db.Decimal(14, 2)
  pisTotal          Decimal @default(0) @map("pis_total") @db.Decimal(14, 2)
  cofinsTotal       Decimal @default(0) @map("cofins_total") @db.Decimal(14, 2)
  issTotal          Decimal @default(0) @map("iss_total") @db.Decimal(14, 2)
  ibsTotal          Decimal @default(0) @map("ibs_total") @db.Decimal(14, 2)
  cbsTotal          Decimal @default(0) @map("cbs_total") @db.Decimal(14, 2)
  importTaxTotal    Decimal @default(0) @map("import_tax_total") @db.Decimal(14, 2)
  selectiveTaxTotal Decimal @default(0) @map("selective_tax_total") @db.Decimal(14, 2)
  /// Total dos tributos (Lei da Transparência, tag vTotTrib).
  grossTaxTotal     Decimal @default(0) @map("gross_tax_total") @db.Decimal(14, 2)
  retentionAmount   Decimal @default(0) @map("retention_amount") @db.Decimal(14, 2)
  total             Decimal @default(0) @db.Decimal(14, 2)

  /// Transporte (NF-e/NFC-e).
  transporterName   String?      @map("transporter_name") @db.VarChar(120)
  transportModFrete Int?         @map("transport_mod_frete")
  vehiclePlate      String?      @map("vehicle_plate") @db.VarChar(10)
  vehicleUf         BrazilState?

  /// Fatura / dados adicionais.
  invoiceNumber       String? @map("invoice_number") @db.VarChar(40)
  purchaseOrderNumber String? @map("purchase_order_number") @db.VarChar(40)
  contractNumber      String? @map("contract_number") @db.VarChar(40)
  additionalData      String? @map("additional_data")

  /// XML, DANFE e comprovante ficam no storage; aqui só o caminho e o hash.
  xmlUrl                    String?   @map("xml_url")
  xmlHash                   String?   @map("xml_hash") @db.VarChar(64)
  danfeUrl                  String?   @map("danfe_url")
  pdfUrl                    String?   @map("pdf_url")
  cifpPdfUrl                String?   @map("cifp_pdf_url")
  cancelledAt               DateTime? @map("cancelled_at")
  cancellationProtocol      String?   @map("cancellation_protocol") @db.VarChar(60)
  cancellationJustification String?   @map("cancellation_justification") @db.VarChar(255)
  substitutedById           String?   @map("substituted_by_id")
  contingencyJE             String?   @map("contingency_je") @db.VarChar(20)

  emittedAt        DateTime? @map("emitted_at")
  canceledAt       DateTime? @map("canceled_at")
  notes            String?
  /// Prazo legal de guarda. Antes de expirar, o job de retenção bloqueia a
  /// exclusão e sinaliza o operador. Depois, exige `approvedForPurge`.
  retentionUntil   DateTime? @map("retention_until")
  approvedForPurge Boolean   @default(false) @map("approved_for_purge")

  /// Chave de idempotência de emissão: o mesmo retry nunca duplica a nota.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)
  issuedById     String? @map("issued_by_id")

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalConfig       FiscalConfig? @relation(fields: [fiscalConfigId], references: [id], onDelete: SetNull)
  fiscalSeries       FiscalSeries? @relation(fields: [fiscalSeriesId], references: [id], onDelete: SetNull)
  sale               Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order              SalesOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase           Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  referenceInvoice   Invoice?      @relation("InvoiceReference", fields: [referenceInvoiceId], references: [id], onDelete: SetNull)
  referencedInvoices Invoice[]     @relation("InvoiceReference")
  substitutedBy      Invoice?      @relation("InvoiceSubstitution", fields: [substitutedById], references: [id], onDelete: SetNull)
  substitutes        Invoice[]     @relation("InvoiceSubstitution")
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  issuedBy           User?         @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  paymentTerms       PaymentTerms? @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)

  items               InvoiceItem[]
  events              InvoiceEvent[]
  logs                FiscalLog[]
  jobs                FiscalJob[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, accessKey])
  @@unique([tenantId, model, series, number, environment, direction])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, emittedAt])
  @@index([tenantId, direction, emittedAt])
  @@index([tenantId, customerId, emittedAt])
  @@index([tenantId, referenceInvoiceId])
  @@index([tenantId, retentionUntil, approvedForPurge])
  @@index([branchId, status])
  @@map("invoices")
}

/// Item da nota. Guarda o snapshot do produto e TODAS as alíquotas que
/// foram aplicadas; se o cadastro do produto mudar, a nota permanece fiel.
model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  productId      String? @map("product_id")
  serviceId      String? @map("service_id")
  saleItemId     String? @map("sale_item_id")
  description    String  @db.VarChar(255)
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// Subtotal do item antes dos tributos.
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  /// Valor bruto (base do ICMS ST / FCP).
  grossAmount    Decimal @default(0) @map("gross_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  ncmCode         String?        @map("ncm_code") @db.VarChar(12)
  ncmTableVersion String?        @map("ncm_table_version") @db.VarChar(20)
  cestCode        String?        @map("cest_code") @db.VarChar(10)
  productOrigin   ProductOrigin?
  cfop            String?        @db.VarChar(8)
  /// Código deaglutinação do item no SPED (tipo de pessoa + item).
  spedItemType    String?        @map("sped_item_type") @db.VarChar(60)

  icmsTaxCode       String? @map("icms_tax_code") @db.VarChar(20)
  icmsBase          Decimal @default(0) @map("icms_base") @db.Decimal(14, 2)
  icmsRatePercent   Decimal @default(0) @map("icms_rate_percent") @db.Decimal(9, 4)
  icmsAmount        Decimal @default(0) @map("icms_amount") @db.Decimal(14, 2)
  icmsStAmount      Decimal @default(0) @map("icms_st_amount") @db.Decimal(14, 2)
  icmsStBase        Decimal @default(0) @map("icms_st_base") @db.Decimal(14, 2)
  fcpAmount         Decimal @default(0) @map("fcp_amount") @db.Decimal(14, 2)
  icmsUfRatePercent Decimal @default(0) @map("icms_uf_rate_percent") @db.Decimal(9, 4)
  icmsUfAmount      Decimal @default(0) @map("icms_uf_amount") @db.Decimal(14, 2)

  pisTaxCode        String? @map("pis_tax_code") @db.VarChar(20)
  pisBase           Decimal @default(0) @map("pis_base") @db.Decimal(14, 2)
  pisRatePercent    Decimal @default(0) @map("pis_rate_percent") @db.Decimal(9, 4)
  pisAmount         Decimal @default(0) @map("pis_amount") @db.Decimal(14, 2)
  cofinsTaxCode     String? @map("cofins_tax_code") @db.VarChar(20)
  cofinsBase        Decimal @default(0) @map("cofins_base") @db.Decimal(14, 2)
  cofinsRatePercent Decimal @default(0) @map("cofins_rate_percent") @db.Decimal(9, 4)
  cofinsAmount      Decimal @default(0) @map("cofins_amount") @db.Decimal(14, 2)
  ipiBase           Decimal @default(0) @map("ipi_base") @db.Decimal(14, 2)
  ipiRatePercent    Decimal @default(0) @map("ipi_rate_percent") @db.Decimal(9, 4)
  ipiAmount         Decimal @default(0) @map("ipi_amount") @db.Decimal(14, 2)
  issBase           Decimal @default(0) @map("iss_base") @db.Decimal(14, 2)
  issRatePercent    Decimal @default(0) @map("iss_rate_percent") @db.Decimal(9, 4)
  issAmount         Decimal @default(0) @map("iss_amount") @db.Decimal(14, 2)

  ibsBase                 Decimal @default(0) @map("ibs_base") @db.Decimal(14, 2)
  ibsRatePercent          Decimal @default(0) @map("ibs_rate_percent") @db.Decimal(9, 4)
  ibsAmount               Decimal @default(0) @map("ibs_amount") @db.Decimal(14, 2)
  cbsBase                 Decimal @default(0) @map("cbs_base") @db.Decimal(14, 2)
  cbsRatePercent          Decimal @default(0) @map("cbs_rate_percent") @db.Decimal(9, 4)
  cbsAmount               Decimal @default(0) @map("cbs_amount") @db.Decimal(14, 2)
  importTaxBase           Decimal @default(0) @map("import_tax_base") @db.Decimal(14, 2)
  importTaxRatePercent    Decimal @default(0) @map("import_tax_rate_percent") @db.Decimal(9, 4)
  importTaxAmount         Decimal @default(0) @map("import_tax_amount") @db.Decimal(14, 2)
  selectiveTaxBase        Decimal @default(0) @map("selective_tax_base") @db.Decimal(14, 2)
  selectiveTaxRatePercent Decimal @default(0) @map("selective_tax_rate_percent") @db.Decimal(9, 4)
  selectiveTaxAmount      Decimal @default(0) @map("selective_tax_amount") @db.Decimal(14, 2)

  /// Tributos FEDERAIS (Lei da Transparência, tag vTotTribNF).
  federalTaxAmount     Decimal @default(0) @map("federal_tax_amount") @db.Decimal(14, 2)
  /// Tributos ESTADUAIS (tag vTotTribNF).
  stateTaxAmount       Decimal @default(0) @map("state_tax_amount") @db.Decimal(14, 2)
  /// Tributos MUNICIPAIS (tag vTotTribNF).
  municipalTaxAmount   Decimal @default(0) @map("municipal_tax_amount") @db.Decimal(14, 2)
  /// Total dos tributos aproximados (tag indTot).
  approximateTaxAmount Decimal @default(0) @map("approximate_tax_amount") @db.Decimal(14, 2)

  /// Info adicional do item (tag infAdProd): alergênicos, rastreio, VALOR).
  additionalData String? @map("additional_data")
  sortOrder      Int     @default(0) @map("sort_order")
  /// Número do controle da venda (para rastreio interno).
  traceId        String? @map("trace_id") @db.VarChar(60)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@index([productId])
  @@index([serviceId])
  @@index([ncmCode])
  @@index([tenantId])
  @@map("invoice_items")
}

/// Evento do ciclo de vida do documento (emissão, consulta, cancelamento,
/// carta de correção, download). Um documento tem vários eventos; a trilha
/// nunca é apagada.
model InvoiceEvent {
  id          String          @id @default(cuid())
  invoiceId   String          @map("invoice_id")
  type        FiscalEventType
  status      JobStatus       @default(SUCCESS)
  message     String?         @db.VarChar(500)
  payload     Json?
  /// Protocolo/digest gerados neste evento.
  protocol    String?         @db.VarChar(60)
  digest      String?         @db.VarChar(80)
  /// Código de erro do autorizador (tag cStat).
  errorCode   String?         @map("error_code") @db.VarChar(20)
  ip          String?         @db.VarChar(64)
  createdById String?         @map("created_by_id")

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InvoiceEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([type, createdAt])
  @@index([tenantId])
  @@map("invoice_events")
}

/// Trilha HTTP completa da integração fiscal: payload enviado ao provedor e
/// resposta recebida. Guarda o necessário para suporte e auditoria. Senhas e
/// tokens NÃO entram no payload: use `headersSanitized`/`bodySanitized`.
model FiscalLog {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  invoiceId       String?            @map("invoice_id")
  integrationId   String?            @map("integration_id")
  direction       FiscalLogDirection
  /// Endpoint chamado (host + path, sem credenciais).
  endpoint        String             @db.VarChar(500)
  httpMethod      String?            @map("http_method") @db.VarChar(10)
  httpStatus      Int?               @map("http_status")
  durationMs      Int?               @map("duration_ms")
  /// Payload ENVIADO, já sanitizado por `sanitizeFiscalPayload`. Formato:
  /// `{ body, headers, maskedKeys[], originalSize, isBinary }`. Nunca gravar o
  /// payload cru: conteria token, client_secret e XML com dados do emitente.
  requestPayload  Json?              @map("request_payload")
  /// Payload RECEBIDO, mesmo formato e mesma sanitização.
  responsePayload Json?              @map("response_payload")
  /// Chaves sensíveis removidas do payload (registro do que foi sanitizado).
  sanitizedKeys   String[]           @default([]) @map("sanitized_keys")
  errorMessage    String?            @map("error_message")
  correlationId   String?            @map("correlation_id") @db.VarChar(60)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  integration FiscalIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([invoiceId, createdAt])
  @@index([integrationId, createdAt])
  @@map("fiscal_logs")
}

/// Fila de operações fiscais. Toda emissão/cancelamento é assíncrono: a
/// requisição cria o job, o worker chama o provedor e atualiza a nota. O
/// usuário acompanha o status sem bloquear a interface.
model FiscalJob {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  invoiceId      String?       @map("invoice_id")
  type           FiscalJobType
  status         JobStatus     @default(PENDING)
  priority       Int           @default(0)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(5) @map("max_attempts")
  payload        Json?
  result         Json?
  errorMessage   String?       @map("error_message")
  /// Fila lógica (ex.: "fiscal:emit", "fiscal:cancel"). Define o
  /// particionamento e a prioridade.
  queue          String        @db.VarChar(40)
  scheduledAt    DateTime?     @map("scheduled_at")
  startedAt      DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  /// Idempotência: mesma chave não enfileira duas vezes.
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(120)
  lockToken      String?       @map("lock_token") @db.VarChar(60)
  lockedAt       DateTime?     @map("locked_at")
  lockedBy       String?       @db.VarChar(80)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, idempotencyKey])
  @@index([status, queue, scheduledAt])
  @@index([tenantId, status, createdAt])
  @@index([invoiceId])
  @@map("fiscal_jobs")
}

// ============================================================================
// AUDITORIA
//
// Regras:
// - `userId` é NULLABLE com `onDelete: SetNull` e o nome do usuário é
//   desnormalizado em `userName`. Apagar um usuário NUNCA destrói o rastro.
// - `changes` guarda apenas o DIFF (antes/depois) e passa por
//   `redactAuditChanges`, que remove CPF/CNPJ/senha/token antes de gravar.
// - Escrita é append-only. Não existe `updatedAt` nem rota de edição.
// ============================================================================

model AuditLog {
  id                  String  @id @default(cuid())
  tenantId            String  @map("tenant_id")
  userId              String? @map("user_id")
  /// Nome do autor no momento do fato (não depende do user ainda existir).
  userName            String? @map("user_name") @db.VarChar(140)
  userEmail           String? @map("user_email") @db.VarChar(180)
  /// Sessão que originou a ação (permite revogar e correlacionar).
  sessionId           String? @map("session_id")
  /// Impersonação de super admin: sem isso, o log parece uma ação normal.
  isImpersonation     Boolean @default(false) @map("is_impersonation")
  impersonationReason String? @map("impersonation_reason") @db.VarChar(255)

  action      AuditAction
  /// Entidade afetada: "Sale", "Invoice", "User", "ChartOfAccount"...
  entity      String      @db.VarChar(60)
  entityId    String?     @map("entity_id") @db.VarChar(40)
  description String?     @db.VarChar(500)
  /// Diff antes/depois já sanitizado. Ver `redactAuditChanges`.
  changes     Json?
  /// Metadados não sensíveis (IP, user-agent, requestId, correlationId).
  metadata    Json?
  /// Webhook/api key usada, quando aplicável.
  apiKeyId    String?     @map("api_key_id")

  ip            String? @db.VarChar(64)
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id") @db.VarChar(60)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

// ============================================================================
// LGPD E PRIVACIDADE
// ============================================================================

/// Registro de consentimento. Guardar a versão do termo é obrigatório: o
/// consentimento dado para a v1.0 não cobre a v2.0.
model ConsentLog {
  id              String      @id @default(cuid())
  userId          String?     @map("user_id")
  /// Sujeito do tratamento quando é cliente final (LGPD), não usuário do ERP.
  customerId      String?     @map("customer_id")
  /// Finalidade: "marketing", "comunicacao", "analytics", "necessario".
  purpose         String      @db.VarChar(80)
  /// Versão do termo aceito.
  documentVersion String      @map("document_version") @db.VarChar(20)
  granted         Boolean
  legalBasis      LegalBasis?
  ip              String?     @db.VarChar(64)
  userAgent       String?     @map("user_agent")
  /// Hash do documento exibido, para provar o conteúdo aceito.
  documentHash    String?     @map("document_hash") @db.VarChar(64)
  notes           String?

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([customerId, purpose])
  @@index([purpose, grantedAt])
  @@index([tenantId])
  @@map("consent_logs")
}

/// Solicitações do titular (art. 18 da LGPD). Prazo legal de resposta: 15
/// dias. O job de rotina alerta sobre vencimento.
model DataSubjectRequest {
  id              String                   @id @default(cuid())
  userId          String?                  @map("user_id")
  customerId      String?                  @map("customer_id")
  /// Protocolo curto exibido ao titular.
  protocol        String                   @db.VarChar(20)
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus @default(ABERTA)
  legalBasis      LegalBasis?
  description     String?                  @db.VarChar(1000)
  /// Prazo legal de 15 dias.
  dueAt           DateTime                 @map("due_at")
  completedAt     DateTime?                @map("completed_at")
  /// Evidência do atendimento (relatório, e-mail, hash de anonimização).
  evidenceUrl     String?                  @map("evidence_url")
  rejectionReason String?                  @map("rejection_reason")
  handledById     String?                  @map("handled_by_id")

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handledBy User?     @relation("DataSubjectHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([protocol])
  @@index([userId, status, type])
  @@index([status, dueAt])
  @@index([customerId])
  @@index([tenantId])
  @@map("data_subject_requests")
}

// ============================================================================
// NOTIFICAÇÕES E SUPORTE
// ============================================================================

model Notification {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  /// Destinatário. NULL = notificação para toda a empresa (broadcast).
  userId      String?              @map("user_id")
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  title       String               @db.VarChar(200)
  message     String               @db.VarChar(1000)
  /// Entidade relacionada, para "ir para" a tela certa.
  entity      String?              @db.VarChar(60)
  entityId    String?              @map("entity_id")
  linkUrl     String?              @map("link_url")
  /// Persistir depois de ler?false = some ao ler.
  persistent  Boolean              @default(false)
  readAt      DateTime?            @map("read_at")
  dismissedAt DateTime?            @map("dismissed_at")
  expiresAt   DateTime?            @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, readAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id                 String         @id @default(cuid())
  tenantId           String         @map("tenant_id")
  /// Protocolo curto exibido ao cliente.
  protocol           String         @db.VarChar(20)
  subject            String         @db.VarChar(200)
  description        String         @db.Text
  status             TicketStatus   @default(ABERTO)
  priority           TicketPriority @default(MEDIA)
  category           String?        @db.VarChar(60)
  openedById         String?        @map("opened_by_id")
  assignedToId       String?        @map("assigned_to_id")
  /// O problema é do produto ou do cliente? Ajuda a separar suporte de bug.
  isProductIssue     Boolean        @default(false) @map("is_product_issue")
  /// Versão do app reportada pelo cliente (para triagem de bug).
  appVersion         String?        @map("app_version") @db.VarChar(20)
  attachments        Json?
  closedAt           DateTime?      @map("closed_at")
  closedReason       String?        @map("closed_reason")
  /// Tempo de primeira resposta e de resolução, para SLA.
  firstResponseAt    DateTime?      @map("first_response_at")
  resolvedAt         DateTime?      @map("resolved_at")
  satisfactionRating Int?           @map("satisfaction_rating")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy   User?            @relation("TicketOpener", fields: [openedById], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, protocol])
  @@index([tenantId, status, priority])
  @@index([tenantId, assignedToId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String    @id @default(cuid())
  ticketId    String    @map("ticket_id")
  authorId    String?   @map("author_id")
  /// false = mensagem do cliente; true = resposta do suporte.
  fromSupport Boolean   @default(false) @map("from_support")
  body        String    @db.Text
  attachments Json?
  readAt      DateTime? @map("read_at")
  /// Mensagens internas visíveis só para a equipe de suporte.
  internal    Boolean   @default(false)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // --- Escopo de tenant (ver docs/adr/0002-tenant-isolation.md) ---
  /// Coluna fisica: e o que a extensao `tenant-guard` filtra e o que o
  /// indice cobre. Preenchida a partir do pai no momento da gravacao.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@index([tenantId])
  @@map("support_messages")
}
