model AccountsReceivable {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  branchId       String                @map("branch_id")
  customerId     String?               @map("customer_id")
  saleId         String?               @map("sale_id")
  paymentTermsId String?               @map("payment_terms_id")
  number         String                @db.VarChar(40)
  kind           PayableReceivableKind @default(CONTAS_A_RECEBER)
  status         FinancialEntryStatus  @default(PENDENTE)

  originAmount    Decimal @map("origin_amount") @db.Decimal(14, 2)
  interestAmount  Decimal @default(0) @map("interest_amount") @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount     Decimal @map("total_amount") @db.Decimal(14, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(14, 2)

  dueDate         DateTime            @map("due_date")
  competenceDate  DateTime            @map("competence_date")
  settledDate     DateTime?           @map("settled_date")
  notes           String?
  documentType    String?             @map("document_type") @db.VarChar(40)
  documentId      String?             @map("document_id")
  documentNumber  String?             @map("document_number") @db.VarChar(40)
  documentDate    DateTime?           @map("document_date")
  category        FinancialEntryType? @map("category")
  notesSettlement String?             @map("notes_settlement")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  paymentTerms PaymentTerms? @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)
