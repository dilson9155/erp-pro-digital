# ============================================================================
# ERP PRO DIGITAL — .env.example
#
# Copie para `.env` e preencha. NUNCA commite `.env` real.
# `.env` já está no .gitignore deste repositório.
#
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# APLICAÇÃO
# ----------------------------------------------------------------------------
# Ambiente: development | test | production
NODE_ENV=development

# URL pública da aplicação. Usada em links de e-mail, recovery e webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# BANCO DE DADOS (OBRIGATÓRIO — PostgreSQL)
# ----------------------------------------------------------------------------
# Regras:
#   - NEVER SQLite. NEVER string de conexão de projeto de demonstração em produção.
#   - Em produção use um Postgres gerenciado FORA da Vercel (Neon, Supabase,
#     RDS, Cloud SQL, Aiven) com pooling. Ver `docs/operations.md`.
#
# Dev local:
DATABASE_URL="postgresql://erp_app:troque-esta-senha@localhost:5432/erp_prod_digital?schema=public"

# Usado apenas por `prisma migrate dev` (cria/descarta banco de sombra).
# Omitir em produção.
# SHADOW_DATABASE_URL="postgresql://erp_app:troque-esta-senha@localhost:5432/erp_prod_digital_shadow?schema=public"

# Limites do pool de conexões do driver `pg`.
# Em serverless, use o pooler do provedor e valores baixos.
# DATABASE_POOL_MAX=5
# DATABASE_POOL_TIMEOUT_MS=10000
# DATABASE_CONNECT_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# AUTENTICAÇÃO (OBRIGATÓRIO)
# ----------------------------------------------------------------------------
# Segredo de assinatura de sessão. Mínimo 32 bytes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ROTACIONAR esta variável invalida todas as sessões abertas. É o kill-switch
# global em caso de comprometimento.
AUTH_SECRET=""

# Vida da sessão (cookie HttpOnly). O registro em `sessions` é a fonte de verdade.
SESSION_TTL_SECONDS=43200
# "Lembrar acesso" estende a sessão para 30 dias.
SESSION_TTL_REMEMBER_SECONDS=2592000

# Nome do cookie de sessão. Não usar "__Host-" fora de HTTPS com domínio exato.
SESSION_COOKIE_NAME="epd_session"

# Custo do bcrypt (2^12). NÃO baixar em produção.
BCRYPT_COST=12

# Origens autorizadas para requisições de escrita (CSRF / CORS).
# Lista separada por vírgula. Vazio = usa APP_URL + host de desenvolvimento.
ALLOWED_ORIGINS=""

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# "memory" (dev, single instance) | "upstash" (produção serverless)
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_SECONDS=60

# Quando RATE_LIMIT_DRIVER=upstash, configure também:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# BLOQUEIO POR TENTATIVAS DE LOGIN
# ----------------------------------------------------------------------------
# Diferente do rate limit acima. O rate limit conta tentativas por IP e por
# conta numa janela curta. Isto conta falhas CONSECUTIVAS DA CONTA e persiste
# no banco, protegendo a conta mesmo quando o atacante troca de IP.
# Os dois juntos: o rate limit sozinho não sobrevive a um botnet; o bloqueio
# sozinho é contornável reiniciando o contador.
LOGIN_MAX_ATTEMPTS=5
# Escalonamento progressivo: 1x, 2x, 4x, 8x a partir do base, até o teto.
# Bloqueio fixo e longo tranca a vítima de forma permanente, já que o atacante
# só precisa repetir o ciclo.
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600

# ----------------------------------------------------------------------------
# FISCAL (NF-e / NFC-e / NFS-e)
# ----------------------------------------------------------------------------
# ATENÇÃO: a tributação NÃO é codificada na aplicação. Alíquotas, NCM, CEST,
# CFOP e CST vêm do banco e são configurados pelo contador.
# Ver `docs/fiscal.md`.
FISCAL_PROVIDER=focus
FISCAL_ENVIRONMENT=homologacao
FISCAL_API_URL=""
FISCAL_API_TOKEN=""
# Referência para a próxima viagem de NF-e (sigla "ref" do layout do provedor).
FISCAL_REF_ULTIMA_VIAGEM=""
# Identificador da instalação, para evitar colisão de `ref` entre installs.
FISCAL_HMAC_KEY=""

# Certificados digitais: guardados em storage cifrado, nunca no repositório
# e nunca em variável de ambiente em texto puro.
STORAGE_URL=""
STORAGE_BUCKET=""

# ----------------------------------------------------------------------------
# E-MAIL
# ----------------------------------------------------------------------------
# Enquanto SMTP não estiver configurado, o sistema reporta
# "Integração não configurada." e registra a intenção em `notification_outbox`.
EMAIL_DRIVER=log
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="ERP PRO Digital <nao-responda@example.com>"

# ----------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS (todas opcionais)
# ----------------------------------------------------------------------------
# BrasilAPI / ViaCEP para busca de CEP. Vazio = integração não configurada.
BRAPI_BASE_URL="https://brasilapi.com.br/api"
# Fonte de tabelas fiscais (NCM, CEST, CFOP, IBS/CBS). Vazio = desabilitado.
FISCAL_TABLES_URL=""

# Gateway de pagamento (assinaturas SaaS). Vazio = assinatura em modo manual.
BILLING_PROVIDER=""
BILLING_API_URL=""
BILLING_API_TOKEN=""
BILLING_WEBHOOK_SECRET=""

# WhatsApp (nada de integração simulada — sem config, o sistema informa
# "Integração não configurada.").
WHATSAPP_PROVIDER=""
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ----------------------------------------------------------------------------
# OBSERVABILIDADE
# ----------------------------------------------------------------------------
# Level de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# "pretty" em dev, "json" em produção (obrigatório para agregadores de log).
LOG_PRETTY=true
# Nome do serviço reportado ao agregador de logs.
LOG_SERVICE_NAME="erp-pro-digital"

# ----------------------------------------------------------------------------
# ONDE O NOME DO PRODUTO VIVE
# ----------------------------------------------------------------------------
# Nome provisório. Definido em `src/config/branding.ts` (fonte de verdade do
# front). Estas variáveis sobrescrevem o valor padrão quando presentes.
NEXT_PUBLIC_APP_NAME="ERP PRO Digital"
NEXT_PUBLIC_APP_TAGLINE="Gestão completa para sua empresa"
NEXT_PUBLIC_APP_SUPPORT_EMAIL="suporte@erpprodigital.com.br"
