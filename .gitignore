# ============================================================================
# ERP PRO DIGITAL — .gitignore
# Segredos, artefatos de build e dependências NUNCA entram no repositório.
# ============================================================================

# --- Segredos (REGRA ABSOLUTA) ---------------------------------------------
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.key
*.crt
*.cer
certificados/
secrets/

# --- Dependências -----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build ------------------------------------------------------------------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# --- Prisma -----------------------------------------------------------------
# Client gerado é reproduzível: nunca versionar.
src/generated/
# Backups e dumps de banco NUNCA entram no git.
*.sql.gz
*.dump
backups/

# --- Testes -----------------------------------------------------------------
coverage/
.nyc_output/

# --- Logs e temporários -----------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-output.log
tmp/
temp/

# --- Sistema operacional ----------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Vercel -----------------------------------------------------------------
.vercel
.vercel_build_output

# --- PWA (gerado) -----------------------------------------------------------
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
